<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.ReclaimPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <controls:VolumeAccentRoleToBrushConverter x:Key="VolumeAccent" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Volume context strip. Bars show what the machine looks like after the current
                selection, which is why they update as rows are ticked rather than only after a scan.
            -->
            <ItemsControl
                Grid.Row="0"
                AutomationProperties.AutomationId="ReclaimVolumeStrip"
                AutomationProperties.Name="Volumes on this machine"
                ItemsSource="{x:Bind ViewModel.VolumeStripEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="storage:VolumeStripEntry">
                        <controls:VolumeCard
                            AccentBrush="{x:Bind AccentRole, Converter={StaticResource VolumeAccent}}"
                            IsSystemVolume="{x:Bind IsSystemVolume}"
                            ReclaimableBytes="{x:Bind ReclaimableBytes}"
                            Volume="{x:Bind Volume}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Header: what was found, and the controls that start or stop finding it.  -->
            <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Reclaim" />
                <!--
                    Do not put x:Name="StatusText" on the TextBlock below. A page-level x:Name
                    that matches a property bound by {x:Bind} inside a DataTemplate elsewhere in
                    the same file (ReclaimCategoryViewModel.StatusText, in the category list)
                    crashes MarkupCompilePass2 with WMC9999 instead of reporting the collision.
                -->
                <TextBlock
                    AutomationProperties.AutomationId="ReclaimStatus"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ProgressRing
                    AutomationProperties.AutomationId="ReclaimProgressRing"
                    IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                    Width="20"
                    Height="20" />
                <Button
                    AutomationProperties.AutomationId="ReclaimCancelButton"
                    Command="{x:Bind ViewModel.CancelScanCommand}"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ReclaimScanButton"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Scan this machine"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--  Body: category rail, candidate table, inspector.  -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8">
                <ListView
                    AutomationProperties.AutomationId="ReclaimCategoryList"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReclaimCategoryViewModel">
                            <Grid ColumnSpacing="12" Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontSize="16"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind TotalText, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        ColumnSpacing="12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay, FallbackValue='Candidates'}"
                            VerticalAlignment="Center" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="ReclaimSelectSafeButton"
                                Command="{x:Bind ViewModel.SelectSafeCommand}"
                                Content="Select safe only" />
                            <Button
                                AutomationProperties.AutomationId="ReclaimClearButton"
                                Command="{x:Bind ViewModel.ClearSelectionCommand}"
                                Content="Clear" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ReclaimRowList"
                        ItemsSource="{x:Bind ViewModel.SelectedCategory.Rows, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReclaimRowViewModel">
                                <Grid ColumnSpacing="12" Padding="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        AutomationProperties.Name="{x:Bind DisplayName}"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        MinWidth="0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DetailText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!--  A selected row inside another selected row contributes nothing; say so.  -->
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Already included in the row above it"
                                            Visibility="{x:Bind IsAbsorbed, Mode=OneWay}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind RiskText}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="3"
                                        MinWidth="76"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind SizeText}"
                                        TextAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Inspector: the same four questions in the same order, ending in cost to get it back.  -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What this is" />
                        <TextBlock
                            AutomationProperties.AutomationId="ReclaimInspectorName"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Select a row.'}"
                            TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Where it is" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.Path, Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Why it is safe or not" />
                        <TextBlock
                            AutomationProperties.AutomationId="ReclaimInspectorReason"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.ReasonText, Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cost to get it back" />
                        <TextBlock
                            AutomationProperties.AutomationId="ReclaimInspectorRecovery"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.RecoveryText, Mode=OneWay, FallbackValue=''}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  After you reclaim: what the machine looks like afterwards, not what was deleted.  -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Found" />
                    <TextBlock
                        AutomationProperties.AutomationId="ReclaimFoundBytes"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.FoundBytesText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Selected" />
                    <TextBlock
                        AutomationProperties.AutomationId="ReclaimSelectedBytes"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                </StackPanel>

                <ItemsControl
                    Grid.Column="2"
                    AutomationProperties.AutomationId="ReclaimVolumeImpacts"
                    ItemsSource="{x:Bind ViewModel.VolumeImpacts}"
                    VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReclaimVolumeImpact">
                            <StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind VolumeRoot}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind BytesText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        </Grid>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="1"
            AutomationProperties.AutomationId="ReclaimStatusBar"
            Hints="Space select · Enter open" />
    </Grid>
</Page>
