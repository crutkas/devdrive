<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.ReclaimPage"
    x:Name="ReclaimRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Context strip. The volume bars show what the machine looks like after the current
            selection, which is why they update as rows are ticked rather than only after a scan.
            The room's primary action lives here, on the strip, for the same reason the Space room
            puts scanning on its strip: the thing you act on and the thing you act with belong
            together.
        -->
        <Grid
            Grid.Row="0"
            Padding="18,10"
            ColumnSpacing="14"
            BorderBrush="{ThemeResource SmDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                Grid.Column="0"
                AutomationProperties.AutomationId="ReclaimVolumeStrip"
                AutomationProperties.Name="Volumes on this machine"
                ItemsSource="{x:Bind ViewModel.VolumeStripEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="storage:VolumeStripEntry">
                        <controls:VolumeCard
                            AccentRole="{x:Bind AccentRole}"
                            IsSystemVolume="{x:Bind IsSystemVolume}"
                            ReclaimableBytes="{x:Bind ReclaimableBytes}"
                            Volume="{x:Bind Volume}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="18"
                    Height="18"
                    AutomationProperties.AutomationId="ReclaimProgressRing"
                    IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ReclaimCancelButton"
                    Command="{x:Bind ViewModel.CancelScanCommand}"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ReclaimScanButton"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Scan this machine"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--
            The room. Same three-column grammar as Space, and deliberately so: the category rail
            answers "what kind", the centre answers "which ones", the inspector answers "should I".
            The centre is a table over an always-visible visual, exactly like the table over the
            treemap next door.
        -->
        <Grid
            Grid.Row="1"
            Padding="18,11"
            ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!--  ================= Category rail =================  -->
            <Border Grid.Column="0" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                Title is Auto and the status takes the slack. The rail is 236 wide
                                and the two together do not always fit; when something has to give it
                                must be the status, which is repeated verbatim in the status bar at
                                the foot of the room. A truncated card title is just a broken card.
                            -->
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmCardTitleTextStyle}"
                                Text="What was found" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ReclaimStatus"
                                Style="{StaticResource SmCardSubTextStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ReclaimCategoryList"
                        AutomationProperties.Name="Categories of reclaimable space"
                        ItemsSource="{x:Bind ViewModel.Categories}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReclaimCategoryViewModel">
                                <Grid
                                    Padding="13,7,13,7"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource SmDimBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SmCellTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource SmCardSubTextStyle}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind TotalText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                        The risk composition of everything found. The category list answers "where is
                        it"; this answers "how much of it can I take without thinking", which is the
                        question that decides whether the room is worth the next five minutes.
                    -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="0,11,0,0"
                        BorderBrush="{ThemeResource SmDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Spacing="7"
                        Visibility="{x:Bind ViewModel.FoundRiskMix.HasAny, Mode=OneWay}">
                        <TextBlock
                            Margin="13,0"
                            Style="{StaticResource SmSectionLabelTextStyle}"
                            Text="{x:Bind ViewModel.FoundRiskMix.Headline, Mode=OneWay}" />
                        <controls:CapacityBar
                            Height="12"
                            Margin="13,0"
                            AutomationProperties.AutomationId="ReclaimRiskMixBar"
                            AutomationProperties.Name="Risk composition of everything found"
                            Capacity="{x:Bind ViewModel.FoundRiskMix.Bar, Mode=OneWay}"
                            CornerRadius="3" />

                        <StackPanel Margin="13,0,13,4" Spacing="3">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SmGoodBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.SafeCountText, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SmTreeValueTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.SafeText, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SmWarnBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.CheckCountText, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SmTreeValueTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.CheckText, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Grid.Column="0"
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SmBadBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.CarefulCountText, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SmTreeValueTextStyle}"
                                    Text="{x:Bind ViewModel.FoundRiskMix.CarefulText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <!--
                            The legend earns its space by defining the tiers in the user's terms
                            rather than ours. A colour key alone would say which band is which
                            without saying what the bands mean.
                        -->
                        <Border
                            Padding="13,8,13,9"
                            Background="{ThemeResource SmCardHeaderBrush}"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,1,0,0">
                            <TextBlock Style="{StaticResource SmCardSubTextStyle}" TextWrapping="Wrap">
                                Safe is regenerable with no decision. Check is almost certainly fine but you should glance. Careful can lose work that exists nowhere else.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ================= Candidates, over the after-picture =================  -->
            <Grid Grid.Column="1" RowSpacing="11">
                <Grid.RowDefinitions>
                    <!--
                        Table is Auto and the after-picture takes the slack, matching the Space
                        room. The reverse leaves dead space under a short table, which reads as a
                        rendering bug rather than a design choice.
                    -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    SizeChanged="TableCard_SizeChanged"
                    Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay, FallbackValue='Candidates'}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Button
                                        AutomationProperties.AutomationId="ReclaimSelectSafeButton"
                                        Command="{x:Bind ViewModel.SelectSafeCommand}"
                                        Content="Select safe only"
                                        Style="{StaticResource SmCompactButtonStyle}" />
                                    <Button
                                        AutomationProperties.AutomationId="ReclaimClearButton"
                                        Command="{x:Bind ViewModel.ClearSelectionCommand}"
                                        Content="Clear"
                                        Style="{StaticResource SmCompactButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Column header. Widths are shared with the row template below.  -->
                        <Border
                            Grid.Row="1"
                            Padding="14,7,14,7"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind NameColumnWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="26,0,0,0"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="WHAT" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="RISK" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="SIZE" />
                            </Grid>
                        </Border>

                        <ListView
                            Grid.Row="2"
                            MaxHeight="268"
                            AutomationProperties.AutomationId="ReclaimRowList"
                            AutomationProperties.Name="Candidates in the selected category"
                            ItemsSource="{x:Bind ViewModel.SelectedCategory.Rows, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReclaimRowViewModel">
                                    <Grid
                                        Padding="14,6,14,6"
                                        AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding NameColumnWidth, ElementName=ReclaimRoot}" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            A Grid, not a horizontal StackPanel. A StackPanel hands
                                            its children an unconstrained width, so the name cell
                                            never learns the column width, TextTrimming never
                                            engages, and long paths are hard clipped without an
                                            ellipsis.
                                        -->
                                        <Grid Grid.Column="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource SmCellTextStyle}"
                                                    Text="{x:Bind DisplayName}"
                                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                                <TextBlock
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="{x:Bind DetailText}" />
                                                <!--  A selected row inside another selected row contributes nothing; say so.  -->
                                                <TextBlock
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="Already included in the row above it"
                                                    Visibility="{x:Bind IsAbsorbed, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            Style="{x:Bind local:UiHelpers.RiskChipStyle(RiskEmphasis)}">
                                            <TextBlock
                                                Style="{x:Bind local:UiHelpers.RiskChipTextStyle(RiskEmphasis)}"
                                                Text="{x:Bind RiskText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--
                            The selection footer. Every number needed to press the button, on the
                            same line as the button: how much, out of how much, split by risk, and
                            on which volume. Found and selected live here rather than beside the
                            after-picture because this is where the decision is actually made.
                        -->
                        <Border
                            Grid.Row="3"
                            Padding="13,9,13,10"
                            Background="{ThemeResource SmCardHeaderBrush}"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ReclaimSelectedBytes"
                                        AutomationProperties.Name="Total selected"
                                        Foreground="{ThemeResource SmGoodBrush}"
                                        Style="{StaticResource SmTierValueTextStyle}"
                                        Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="selected of" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AutomationId="ReclaimFoundBytes"
                                        AutomationProperties.Name="Total found"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.FoundBytesText, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="found" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">
                                    <controls:CapacityBar
                                        Height="8"
                                        AutomationProperties.AutomationId="ReclaimSelectionRiskBar"
                                        AutomationProperties.Name="Risk composition of the selection"
                                        Capacity="{x:Bind ViewModel.SelectedRiskMix.Bar, Mode=OneWay}" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="ReclaimFooterDetail"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind ViewModel.FooterDetailText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ReclaimReviewButton"
                                    Command="{x:Bind ViewModel.ReclaimCommand}"
                                    Content="{x:Bind ViewModel.ReclaimButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanReclaim, Mode=OneWay}"
                                    Style="{StaticResource SmCompactButtonStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--
                    After you reclaim. The point of the room: what the machine looks like
                    afterwards, not a receipt for what was deleted. Always visible, and live as
                    rows are ticked.
                -->
                <Border Grid.Row="1" Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="After you reclaim" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="live as you tick" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14,12" Spacing="14">
                                <ItemsControl
                                    AutomationProperties.AutomationId="ReclaimVolumeImpacts"
                                    AutomationProperties.Name="What each volume gets back"
                                    ItemsSource="{x:Bind ViewModel.VolumeImpacts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReclaimVolumeImpact">
                                            <Grid
                                                AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                                ColumnSpacing="11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="31" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--
                                                    The letter tile. A volume is identified by its
                                                    letter far faster than by its label, and giving
                                                    the letter its own tile lets the three text rows
                                                    beside it share one left edge.
                                                -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="31"
                                                    Height="31"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource SmCardHeaderBrush}"
                                                    BorderBrush="{ThemeResource SmStrokeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SmVolumeLetterTextStyle}"
                                                        Text="{x:Bind Letter}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Style="{StaticResource SmCellTextStyle}"
                                                            Text="{x:Bind Name}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            Style="{StaticResource SmCardSubTextStyle}"
                                                            Text="{x:Bind Caption}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <!--
                                                            "100.7 GB → 481.7 GB free". The arrow is
                                                            the row: a single number cannot say
                                                            whether it changed anything.
                                                        -->
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                            Style="{StaticResource SmCardSubTextStyle}">
                                                            <Run Text="{x:Bind FreeBeforeText}" />
                                                            <Run Text="→" />
                                                            <Run Foreground="{ThemeResource SmGoodBrush}" Text="{x:Bind FreeAfterText}" />
                                                            <Run Text="free" />
                                                        </TextBlock>
                                                    </Grid>

                                                    <!--
                                                        One bar, not two. The freed band is hatched
                                                        and sits exactly where those bytes are about
                                                        to move — between what stays in use and what
                                                        was already free — so the delta is read in
                                                        place rather than by diffing two pictures.
                                                    -->
                                                    <controls:CapacityBar Height="9" Capacity="{x:Bind Bar}" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Style="{StaticResource SmCardSubTextStyle}"
                                                            Text="{x:Bind StillInUseText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource SmGoodBrush}"
                                                            Style="{StaticResource SmTreeValueTextStyle}"
                                                            Text="{x:Bind GainText}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    The tiers. Four cards over the selection, because "131.6 GB" is
                                    a number and "131.6 GB, all of it regenerable" is a decision.
                                    Total sits alongside rather than below so the three parts and
                                    their sum are read in one line.
                                -->
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SmTierCardStyle}">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SmGoodBrush}" />
                                                <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="SAFE" />
                                            </StackPanel>
                                            <TextBlock
                                                AutomationProperties.AutomationId="ReclaimTierSafe"
                                                Style="{StaticResource SmTierValueTextStyle}"
                                                Text="{x:Bind ViewModel.SelectedRiskMix.SafeText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.SafeCountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource SmTierCardStyle}">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SmWarnBrush}" />
                                                <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="CHECK" />
                                            </StackPanel>
                                            <TextBlock
                                                AutomationProperties.AutomationId="ReclaimTierCheck"
                                                Style="{StaticResource SmTierValueTextStyle}"
                                                Text="{x:Bind ViewModel.SelectedRiskMix.CheckText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.CheckCountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SmTierCardStyle}">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SmBadBrush}" />
                                                <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="CAREFUL" />
                                            </StackPanel>
                                            <TextBlock
                                                AutomationProperties.AutomationId="ReclaimTierCareful"
                                                Style="{StaticResource SmTierValueTextStyle}"
                                                Text="{x:Bind ViewModel.SelectedRiskMix.CarefulText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.CarefulCountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Style="{StaticResource SmTierCardStyle}">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SmCategory0Brush}" />
                                                <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="TOTAL" />
                                            </StackPanel>
                                            <TextBlock
                                                AutomationProperties.AutomationId="ReclaimTierTotal"
                                                Style="{StaticResource SmTierValueTextStyle}"
                                                Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!--  Nothing ticked is a state, not an empty pane. Say what to do.  -->
                                <TextBlock
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= Inspector =================  -->
            <Border Grid.Column="2" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ReclaimInspectorName"
                            Style="{StaticResource SmCardTitleTextStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Nothing selected'}" />
                    </Border>

                    <!--  The same four questions in the same order, ending in cost to get it back.  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,12" Spacing="4">
                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT THIS IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Select a row.'}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHERE IT IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.Path, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHY IT IS SAFE OR NOT" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="ReclaimInspectorReason"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.ReasonText, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="COST TO GET IT BACK" />
                            <TextBlock
                                AutomationProperties.AutomationId="ReclaimInspectorRecovery"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.RecoveryText, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="ReclaimStatusBar"
            AutomationProperties.Name="Reclaim status"
            Hints="Space select · Enter open" />
    </Grid>
</Page>
