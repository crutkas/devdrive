<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.ReclaimPage"
    x:Name="ReclaimRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <controls:VolumeAccentRoleToBrushConverter x:Key="VolumeAccent" />
        <controls:StatusEmphasisToBrushConverter x:Key="StatusBrush" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Context strip. The volume bars show what the machine looks like after the current
            selection, which is why they update as rows are ticked rather than only after a scan.
            The room's primary action lives here, on the strip, for the same reason the Space room
            puts scanning on its strip: the thing you act on and the thing you act with belong
            together.
        -->
        <Grid
            Grid.Row="0"
            Padding="18,10"
            ColumnSpacing="14"
            BorderBrush="{ThemeResource SmDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                Grid.Column="0"
                AutomationProperties.AutomationId="ReclaimVolumeStrip"
                AutomationProperties.Name="Volumes on this machine"
                ItemsSource="{x:Bind ViewModel.VolumeStripEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="storage:VolumeStripEntry">
                        <controls:VolumeCard
                            AccentBrush="{x:Bind AccentRole, Converter={StaticResource VolumeAccent}}"
                            IsSystemVolume="{x:Bind IsSystemVolume}"
                            ReclaimableBytes="{x:Bind ReclaimableBytes}"
                            Volume="{x:Bind Volume}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="18"
                    Height="18"
                    AutomationProperties.AutomationId="ReclaimProgressRing"
                    IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ReclaimCancelButton"
                    Command="{x:Bind ViewModel.CancelScanCommand}"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ReclaimScanButton"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Scan this machine"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!--
            The room. Same three-column grammar as Space, and deliberately so: the category rail
            answers "what kind", the centre answers "which ones", the inspector answers "should I".
            The centre is a table over an always-visible visual, exactly like the table over the
            treemap next door.
        -->
        <Grid
            Grid.Row="1"
            Padding="18,11"
            ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!--  ================= Category rail =================  -->
            <Border Grid.Column="0" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmCardTitleTextStyle}"
                                Text="What was found" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ReclaimStatus"
                                Style="{StaticResource SmCardSubTextStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ReclaimCategoryList"
                        AutomationProperties.Name="Categories of reclaimable space"
                        ItemsSource="{x:Bind ViewModel.Categories}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReclaimCategoryViewModel">
                                <Grid
                                    Padding="13,7,13,7"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource SmDimBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SmCellTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource SmCardSubTextStyle}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind TotalText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  ================= Candidates, over the after-picture =================  -->
            <Grid Grid.Column="1" RowSpacing="11">
                <Grid.RowDefinitions>
                    <!--
                        Table is Auto and the after-picture takes the slack, matching the Space
                        room. The reverse leaves dead space under a short table, which reads as a
                        rendering bug rather than a design choice.
                    -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    SizeChanged="TableCard_SizeChanged"
                    Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay, FallbackValue='Candidates'}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Button
                                        AutomationProperties.AutomationId="ReclaimSelectSafeButton"
                                        Command="{x:Bind ViewModel.SelectSafeCommand}"
                                        Content="Select safe only"
                                        Style="{StaticResource SmCompactButtonStyle}" />
                                    <Button
                                        AutomationProperties.AutomationId="ReclaimClearButton"
                                        Command="{x:Bind ViewModel.ClearSelectionCommand}"
                                        Content="Clear"
                                        Style="{StaticResource SmCompactButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Column header. Widths are shared with the row template below.  -->
                        <Border
                            Grid.Row="1"
                            Padding="14,7,14,7"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind NameColumnWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="26,0,0,0"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="WHAT" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="RISK" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="SIZE" />
                            </Grid>
                        </Border>

                        <ListView
                            Grid.Row="2"
                            MaxHeight="268"
                            AutomationProperties.AutomationId="ReclaimRowList"
                            AutomationProperties.Name="Candidates in the selected category"
                            ItemsSource="{x:Bind ViewModel.SelectedCategory.Rows, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReclaimRowViewModel">
                                    <Grid
                                        Padding="14,6,14,6"
                                        AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding NameColumnWidth, ElementName=ReclaimRoot}" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            A Grid, not a horizontal StackPanel. A StackPanel hands
                                            its children an unconstrained width, so the name cell
                                            never learns the column width, TextTrimming never
                                            engages, and long paths are hard clipped without an
                                            ellipsis.
                                        -->
                                        <Grid Grid.Column="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource SmCellTextStyle}"
                                                    Text="{x:Bind DisplayName}"
                                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                                <TextBlock
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="{x:Bind DetailText}" />
                                                <!--  A selected row inside another selected row contributes nothing; say so.  -->
                                                <TextBlock
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="Already included in the row above it"
                                                    Visibility="{x:Bind IsAbsorbed, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            BorderBrush="{x:Bind RiskEmphasis, Converter={StaticResource StatusBrush}}"
                                            Style="{StaticResource SmChipStyle}">
                                            <TextBlock
                                                Foreground="{x:Bind RiskEmphasis, Converter={StaticResource StatusBrush}}"
                                                Style="{StaticResource SmCardSubTextStyle}"
                                                Text="{x:Bind RiskText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind SizeText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!--
                    After you reclaim. The point of the room: what the machine looks like
                    afterwards, not a receipt for what was deleted. Always visible, and live as
                    rows are ticked.
                -->
                <Border Grid.Row="1" Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="After you reclaim" />
                                <!--
                                    Found and selected sit here, beside the picture they explain,
                                    rather than in a summary block of their own. The pair is the
                                    decision: how much of what exists have I actually chosen.
                                -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="found" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="ReclaimFoundBytes"
                                        AutomationProperties.Name="Total found"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.FoundBytesText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="selected" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="ReclaimSelectedBytes"
                                        AutomationProperties.Name="Total selected"
                                        Foreground="{ThemeResource SmGoodBrush}"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14,12" Spacing="14">
                                <ItemsControl
                                    AutomationProperties.AutomationId="ReclaimVolumeImpacts"
                                    AutomationProperties.Name="What each volume gets back"
                                    ItemsSource="{x:Bind ViewModel.VolumeImpacts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReclaimVolumeImpact">
                                            <Grid
                                                AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                                ColumnSpacing="12"
                                                RowSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Style="{StaticResource SmCellTextStyle}"
                                                    Text="{x:Bind VolumeRoot}" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                    Foreground="{ThemeResource SmGoodBrush}"
                                                    Style="{StaticResource SmTreeValueTextStyle}"
                                                    Text="{x:Bind BytesText}" />

                                                <!--
                                                    Two bars, stacked and labelled, rather than one
                                                    bar that animates. A before you can still see is
                                                    what makes the after mean anything.
                                                -->
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="now" />
                                                <controls:CapacityBar
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Capacity="{x:Bind Before}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="{x:Bind FreeBeforeText}" />

                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="after" />
                                                <controls:CapacityBar
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    UsedBrush="{ThemeResource SmGoodBrush}"
                                                    Capacity="{x:Bind After}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Foreground="{ThemeResource SmGoodBrush}"
                                                    Style="{StaticResource SmCardSubTextStyle}"
                                                    Text="{x:Bind FreeAfterText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Nothing ticked is a state, not an empty pane. Say what to do.  -->
                                <TextBlock
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= Inspector =================  -->
            <Border Grid.Column="2" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ReclaimInspectorName"
                            Style="{StaticResource SmCardTitleTextStyle}"
                            Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Nothing selected'}" />
                    </Border>

                    <!--  The same four questions in the same order, ending in cost to get it back.  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,12" Spacing="4">
                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT THIS IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Select a row.'}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHERE IT IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.Path, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHY IT IS SAFE OR NOT" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="ReclaimInspectorReason"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.ReasonText, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="COST TO GET IT BACK" />
                            <TextBlock
                                AutomationProperties.AutomationId="ReclaimInspectorRecovery"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.RecoveryText, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="ReclaimStatusBar"
            AutomationProperties.Name="Reclaim status"
            Hints="Space select · Enter open" />
    </Grid>
</Page>
