<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.ReclaimPage"
    x:Name="ReclaimRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Same header grammar as Space: the title and the scan commands share a row. Selection
            impact remains in the room's per-volume impact rows. No bottom margin: the room's own
            11px top padding is the gap, so it is not counted twice.
        -->
        <Grid Grid.Row="0" Margin="18,12,18,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="PageTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind PageTitle}" />
            <controls:RoomScanBar
                x:Name="ScanBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                CanScan="{x:Bind ViewModel.CanScan, Mode=OneWay}"
                CancelRequested="ScanBar_CancelRequested"
                IsScanning="{x:Bind Scans.IsScanning, Mode=OneWay}"
                ScanLabel="Scan this PC"
                ScanRequested="ScanBar_ScanRequested"
                SelectionMode="None"
                StatusText="{x:Bind Scans.StatusText, Mode=OneWay}" />
        </Grid>

        <!--
            The room. Same three-column grammar as Space, and deliberately so: the category rail
            answers "what kind", the centre answers "which ones", the inspector answers "should I".
            The centre is a table over an always-visible visual, exactly like the table over the
            treemap next door.

            Three layouts, by window width (see WidthStates at the foot of the page):
              Wide    1080+  rail 236, centre 380+, inspector 312 — 986 DIPs plus the 72px rail.
              Medium  980+   rail 212, centre 340+, inspector 280 — still three columns, so a
                             1024-wide window keeps the inspector beside the table instead of
                             under 700 DIPs of content.
              Narrow  below  the inspector drops under the rail and the table, and the room scrolls.

            Whenever the room does not scroll, the scroller is switched off so star rows get a real
            height. When it does scroll, row 0 is given a fixed height instead (RoomTopRow), because a
            star row inside a vertical scroller is measured at infinite height — and so is every
            ListView in it, which then realises every item and loses its own scrolling.
        -->
        <ScrollViewer
            x:Name="RoomScroller"
            Grid.Row="1"
            AutomationProperties.AutomationId="ReclaimRoomScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid
                x:Name="RoomGrid"
                Padding="18,11"
                ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="236" />
                    <ColumnDefinition
                        x:Name="CentreColumn"
                        Width="*"
                        MinWidth="380" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="312" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RoomTopRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ================= Category rail =================  -->
                <Border
                    x:Name="RailCard"
                    Grid.Column="0"
                    Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--
                                    Title is Auto and the status takes the slack. The rail is 236 wide
                                    and the two together do not always fit; when something has to give it
                                    must be the status, which is repeated verbatim in the status bar at
                                    the foot of the room. A truncated card title is just a broken card.
                                -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="What was found" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ReclaimStatus"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <ListView
                            x:Name="CategoryList"
                            Grid.Row="1"
                            AutomationProperties.AutomationId="ReclaimCategoryList"
                            AutomationProperties.Name="Categories of reclaimable space"
                            ItemsSource="{x:Bind ViewModel.Categories}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=OneWay}"
                            SelectionChanged="CategoryList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReclaimCategoryViewModel">
                                    <Grid
                                        Padding="13,7,13,7"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                        ColumnSpacing="9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Foreground="{ThemeResource SmDimBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SmCellTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock
                                                Style="{StaticResource SmCardSubTextStyle}"
                                                Text="{x:Bind StatusText, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmTreeValueTextStyle}"
                                            Text="{x:Bind TotalText, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--
                            The risk composition of everything found. The category list answers "where is
                            it"; this answers "how much of it can I take without thinking", which is the
                            question that decides whether the room is worth the next five minutes.
                        -->
                        <StackPanel
                            Grid.Row="2"
                            Padding="0,11,0,0"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Spacing="7"
                            Visibility="{x:Bind ViewModel.FoundRiskMix.HasAny, Mode=OneWay}">
                            <TextBlock
                                Margin="13,0"
                                Style="{StaticResource SmSectionLabelTextStyle}"
                                Text="{x:Bind ViewModel.FoundRiskMix.Headline, Mode=OneWay}" />
                            <controls:CapacityBar
                                Height="12"
                                Margin="13,0"
                                AutomationProperties.AutomationId="ReclaimRiskMixBar"
                                AutomationProperties.Name="Risk composition of everything found"
                                Capacity="{x:Bind ViewModel.FoundRiskMix.Bar, Mode=OneWay}"
                                CornerRadius="3" />

                            <StackPanel Margin="13,0,13,4" Spacing="3">
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SmGoodBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.SafeCountText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.SafeText, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SmWarnBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.CheckCountText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.CheckText, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="6"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SmBadBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.CarefulCountText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SmTreeValueTextStyle}"
                                        Text="{x:Bind ViewModel.FoundRiskMix.CarefulText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <!--
                                The legend earns its space by defining the tiers in the user's terms
                                rather than ours. A colour key alone would say which band is which
                                without saying what the bands mean.
                            -->
                            <Border
                                Padding="13,8,13,9"
                                Background="{ThemeResource SmCardHeaderBrush}"
                                BorderBrush="{ThemeResource SmDividerBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock Style="{StaticResource SmCardSubTextStyle}" TextWrapping="Wrap">
                                    Safe is regenerable with no decision. Check is almost certainly fine but you should glance. Careful can lose work that exists nowhere else.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ================= Candidates, over the after-picture =================  -->
                <Grid Grid.Column="1" RowSpacing="11">
                    <Grid.RowDefinitions>
                        <!--
                            Table is Auto and the after-picture takes the slack, matching the Space
                            room. The reverse leaves dead space under a short table, which reads as a
                            rendering bug rather than a design choice.
                        -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition
                            x:Name="AfterPictureRow"
                            Height="*"
                            MinHeight="150" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        SizeChanged="TableCard_SizeChanged"
                        Style="{StaticResource SmCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmCardTitleTextStyle}"
                                        Text="{x:Bind ViewModel.SelectedCategory.Title, Mode=OneWay, FallbackValue='Candidates'}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="7">
                                        <Button
                                            AutomationProperties.AutomationId="ReclaimSelectSafeButton"
                                            Command="{x:Bind ViewModel.SelectSafeCommand}"
                                            Content="Select safe only"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                        <Button
                                            AutomationProperties.AutomationId="ReclaimClearButton"
                                            Command="{x:Bind ViewModel.ClearSelectionCommand}"
                                            Content="Clear"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Column header. Widths are shared with the row template below.  -->
                            <Border
                                Grid.Row="1"
                                Padding="14,7,14,7"
                                BorderBrush="{ThemeResource SmDividerBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind NameColumnWidth, Mode=OneWay}" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="26,0,0,0"
                                        Style="{StaticResource SmColumnHeaderTextStyle}"
                                        Text="WHAT" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SmColumnHeaderTextStyle}"
                                        Text="RISK" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SmColumnHeaderTextStyle}"
                                        Text="SIZE" />
                                </Grid>
                            </Border>

                            <ListView
                                x:Name="RowList"
                                Grid.Row="2"
                                MaxHeight="268"
                                AutomationProperties.AutomationId="ReclaimRowList"
                                AutomationProperties.Name="Candidates in the selected category"
                                SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=OneWay}"
                                SelectionChanged="RowList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReclaimRowViewModel">
                                        <Grid
                                            Padding="14,6,14,6"
                                            AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding NameColumnWidth, ElementName=ReclaimRoot}" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                                A Grid, not a horizontal StackPanel. A StackPanel hands
                                                its children an unconstrained width, so the name cell
                                                never learns the column width, TextTrimming never
                                                engages, and long paths are hard clipped without an
                                                ellipsis.
                                            -->
                                            <Grid Grid.Column="0" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                    AutomationProperties.Name="{x:Bind DisplayName}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Style="{StaticResource SmCellTextStyle}"
                                                        Text="{x:Bind DisplayName}"
                                                        ToolTipService.ToolTip="{x:Bind Path}" />
                                                    <TextBlock
                                                        Style="{StaticResource SmCardSubTextStyle}"
                                                        Text="{x:Bind DetailText}" />
                                                    <!--  A selected row inside another selected row contributes nothing; say so.  -->
                                                    <TextBlock
                                                        Style="{StaticResource SmCardSubTextStyle}"
                                                        Text="Already included in the row above it"
                                                        Visibility="{x:Bind IsAbsorbed, Mode=OneWay}" />
                                                    <!--
                                                        Why the last run left this row behind. The
                                                        executor knows exactly why; before this line it
                                                        was computed, stored and rendered nowhere, so
                                                        the reader got "1 item could not be removed"
                                                        and no way to find out which or why.
                                                    -->
                                                    <TextBlock
                                                        Style="{StaticResource SmCardSubTextBadStyle}"
                                                        Text="{x:Bind FailureText, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind FailureText, Mode=OneWay}"
                                                        Visibility="{x:Bind HasFailure, Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                Style="{x:Bind local:UiHelpers.RiskChipStyle(RiskEmphasis)}">
                                                <TextBlock
                                                    Style="{x:Bind local:UiHelpers.RiskChipTextStyle(RiskEmphasis)}"
                                                    Text="{x:Bind RiskText}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SmNumericCellTextStyle}"
                                                Text="{x:Bind SizeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!--
                                The selection footer. Every number needed to press the button, on the
                                same line as the button: how much, out of how much, split by risk, and
                                on which volume. Found and selected live here rather than beside the
                                after-picture because this is where the decision is actually made.

                                When the centre column is too narrow for all three side by side (a
                                1024-wide window, or Wide just above its breakpoint), the risk bar
                                drops to a second row rather than pushing the button off the card.
                                The totals and the button stay on one line. See FooterStates.
                            -->
                            <Border
                                x:Name="SelectionFooter"
                                Grid.Row="3"
                                Padding="13,9,13,10"
                                Background="{ThemeResource SmCardHeaderBrush}"
                                BorderBrush="{ThemeResource SmDividerBrush}"
                                BorderThickness="0,1,0,0"
                                SizeChanged="SelectionFooter_SizeChanged">
                                <Grid x:Name="SelectionFooterGrid" ColumnSpacing="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition
                                            x:Name="FooterRiskColumn"
                                            Width="*"
                                            MinWidth="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        x:Name="FooterTotals"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        SizeChanged="SelectionFooter_SizeChanged"
                                        Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.AutomationId="ReclaimSelectedBytes"
                                            AutomationProperties.Name="Total selected"
                                            Foreground="{ThemeResource SmGoodBrush}"
                                            Style="{StaticResource SmTierValueTextStyle}"
                                            Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource SmCardSubTextStyle}"
                                            Text="selected of" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.AutomationId="ReclaimFoundBytes"
                                            AutomationProperties.Name="Total found"
                                            Style="{StaticResource SmTreeValueTextStyle}"
                                            Text="{x:Bind ViewModel.FoundBytesText, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource SmCardSubTextStyle}"
                                            Text="found" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="FooterRisk"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                        <controls:CapacityBar
                                            Height="8"
                                            AutomationProperties.AutomationId="ReclaimSelectionRiskBar"
                                            AutomationProperties.Name="Risk composition of the selection"
                                            Capacity="{x:Bind ViewModel.SelectedRiskMix.Bar, Mode=OneWay}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="ReclaimFooterDetail"
                                            Style="{StaticResource SmCardSubTextStyle}"
                                            Text="{x:Bind ViewModel.FooterDetailText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="FooterActions"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        SizeChanged="SelectionFooter_SizeChanged"
                                        Spacing="8">
                                        <!--
                                            "Stop", not "Cancel". Cancel invites the reading that the run
                                            is undone; it is not. The executor keeps what it has already
                                            removed and marks the rest as not reached, so the honest verb
                                            is the one that only promises to stop making progress.
                                        -->
                                        <Button
                                            AutomationProperties.AutomationId="ReclaimStopButton"
                                            Command="{x:Bind ViewModel.CancelReclaimCommand}"
                                            Content="Stop"
                                            Style="{StaticResource SmCompactButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsReclaiming, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.AutomationId="ReclaimReviewButton"
                                            Command="{x:Bind ViewModel.ReclaimCommand}"
                                            Content="{x:Bind ViewModel.ReclaimButtonText, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanReclaim, Mode=OneWay}"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        After you reclaim. The point of the room: what the machine looks like
                        afterwards, not a receipt for what was deleted. Always visible, and live as
                        rows are ticked.
                    -->
                    <Border Grid.Row="1" Style="{StaticResource SmCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmCardTitleTextStyle}"
                                        Text="After you reclaim" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="live as you tick" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="14,12" Spacing="14">
                                    <ItemsControl
                                        x:Name="VolumeImpactsList"
                                        AutomationProperties.AutomationId="ReclaimVolumeImpacts"
                                        AutomationProperties.Name="What each volume gets back"
                                        ItemsSource="{x:Bind ViewModel.VolumeImpacts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReclaimVolumeImpact">
                                                <Grid
                                                    AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                                    ColumnSpacing="11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="31" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--
                                                        The letter tile. A volume is identified by its
                                                        letter far faster than by its label, and giving
                                                        the letter its own tile lets the three text rows
                                                        beside it share one left edge.
                                                    -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="31"
                                                        Height="31"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource SmCardHeaderBrush}"
                                                        BorderBrush="{ThemeResource SmStrokeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SmVolumeLetterTextStyle}"
                                                            Text="{x:Bind Letter}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource SmCellTextStyle}"
                                                                Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Bottom"
                                                                Style="{StaticResource SmCardSubTextStyle}"
                                                                Text="{x:Bind Caption}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <!--
                                                                "100.7 GB → 481.7 GB free". The arrow is
                                                                the row: a single number cannot say
                                                                whether it changed anything.
                                                            -->
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                                Style="{StaticResource SmCardSubTextStyle}">
                                                                <Run Text="{x:Bind FreeBeforeText}" />
                                                                <Run Text="→" />
                                                                <Run Foreground="{ThemeResource SmGoodBrush}" Text="{x:Bind FreeAfterText}" />
                                                                <Run Text="free" />
                                                            </TextBlock>
                                                        </Grid>

                                                        <!--
                                                            One bar, not two. The freed band is hatched
                                                            and sits exactly where those bytes are about
                                                            to move — between what stays in use and what
                                                            was already free — so the delta is read in
                                                            place rather than by diffing two pictures.
                                                        -->
                                                        <controls:CapacityBar
                                                            Height="9"
                                                            AccentRole="{x:Bind AccentRole}"
                                                            Capacity="{x:Bind Bar}" />

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Style="{StaticResource SmCardSubTextStyle}"
                                                                Text="{x:Bind StillInUseText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource SmGoodBrush}"
                                                                Style="{StaticResource SmTreeValueTextStyle}"
                                                                Text="{x:Bind GainText}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        The tiers. Four cards over the selection, because "131.6 GB" is
                                        a number and "131.6 GB, all of it regenerable" is a decision.
                                        Total sits alongside rather than below so the three parts and
                                        their sum are read in one line.
                                    -->
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource SmTierCardStyle}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource SmGoodBrush}" />
                                                    <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="SAFE" />
                                                </StackPanel>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="ReclaimTierSafe"
                                                    Style="{StaticResource SmTierValueTextStyle}"
                                                    Text="{x:Bind ViewModel.SelectedRiskMix.SafeText, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.SafeCountText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource SmTierCardStyle}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource SmWarnBrush}" />
                                                    <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="CHECK" />
                                                </StackPanel>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="ReclaimTierCheck"
                                                    Style="{StaticResource SmTierValueTextStyle}"
                                                    Text="{x:Bind ViewModel.SelectedRiskMix.CheckText, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.CheckCountText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SmTierCardStyle}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource SmBadBrush}" />
                                                    <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="CAREFUL" />
                                                </StackPanel>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="ReclaimTierCareful"
                                                    Style="{StaticResource SmTierValueTextStyle}"
                                                    Text="{x:Bind ViewModel.SelectedRiskMix.CarefulText, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedRiskMix.CarefulCountText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="3" Style="{StaticResource SmTierCardStyle}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource SmCategory0Brush}" />
                                                    <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="TOTAL" />
                                                </StackPanel>
                                                <TextBlock
                                                    AutomationProperties.AutomationId="ReclaimTierTotal"
                                                    Style="{StaticResource SmTierValueTextStyle}"
                                                    Text="{x:Bind ViewModel.SelectedBytesText, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource SmCardSubTextStyle}" Text="{x:Bind ViewModel.SelectedCountText, Mode=OneWay}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!--  Nothing ticked is a state, not an empty pane. Say what to do.  -->
                                    <TextBlock
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ================= Inspector =================  -->
                <Border
                    x:Name="InspectorCard"
                    Grid.Column="2"
                    Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ReclaimInspectorName"
                                Style="{StaticResource SmCardTitleTextStyle}"
                                Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Nothing selected'}" />
                        </Border>

                        <!--  The same four questions in the same order, ending in how to get it back.  -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="14,12" Spacing="2">
                                <!--
                                    Ahead of the four standing questions, and only when it applies.
                                    If the last run left this row behind, that is the most important
                                    thing about it right now — more urgent than what it is. The row's
                                    own sub-line trims to the column width; this is where the whole
                                    sentence fits.
                                -->
                                <TextBlock
                                    Style="{StaticResource SmInspectorHeadingTextStyle}"
                                    Text="Why it's still here"
                                    Visibility="{x:Bind ViewModel.SelectedRow.HasFailure, Mode=OneWay, FallbackValue=Collapsed}" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    AutomationProperties.AutomationId="ReclaimInspectorFailure"
                                    Style="{StaticResource SmInspectorBodyBadTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedRow.FailureText, Mode=OneWay, FallbackValue=''}"
                                    Visibility="{x:Bind ViewModel.SelectedRow.HasFailure, Mode=OneWay, FallbackValue=Collapsed}" />

                                <TextBlock Style="{StaticResource SmInspectorHeadingTextStyle}" Text="What" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    Style="{StaticResource SmInspectorBodyTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedRow.DisplayName, Mode=OneWay, FallbackValue='Select a row.'}" />

                                <TextBlock Style="{StaticResource SmInspectorHeadingTextStyle}" Text="Location" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource SmInspectorBodyTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedRow.Path, Mode=OneWay, FallbackValue=''}" />

                                <TextBlock Style="{StaticResource SmInspectorHeadingTextStyle}" Text="Why" />
                                <TextBlock
                                    Margin="0,0,0,16"
                                    AutomationProperties.AutomationId="ReclaimInspectorReason"
                                    Style="{StaticResource SmInspectorBodyTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedRow.ReasonText, Mode=OneWay, FallbackValue=''}" />

                                <TextBlock Style="{StaticResource SmInspectorHeadingTextStyle}" Text="How to recover" />
                                <TextBlock
                                    AutomationProperties.AutomationId="ReclaimInspectorRecovery"
                                    Style="{StaticResource SmInspectorBodyTextStyle}"
                                    Text="{x:Bind ViewModel.SelectedRow.RecoveryText, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="ReclaimStatusBar"
            AutomationProperties.Name="Reclaim status"
            Hints="Space select · Enter open" />

        <VisualStateManager.VisualStateGroups>
            <!--
                Width and height are separate groups that never set the same property, so whichever
                pair of states is active, neither undoes the other on its way out.
            -->
            <VisualStateGroup x:Name="WidthStates">
                <!--  986 DIPs of columns + 72 of rail + slack.  -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--
                    Still three columns, each a little leaner: 212 + 340 + 280 + gutters is 890 DIPs,
                    plus the rail. Stacking at this width put the inspector — the "should I" half of
                    the room — below the fold of a 1024 x 700 window.
                -->
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailColumn.Width" Value="212" />
                        <Setter Target="CentreColumn.MinWidth" Value="340" />
                        <Setter Target="InspectorColumn.Width" Value="280" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RoomScroller.VerticalScrollMode" Value="Enabled" />
                        <Setter Target="RoomScroller.VerticalScrollBarVisibility" Value="Auto" />
                        <!--
                            Bounded, because the scroller is now live: a star row would be measured at
                            infinite height and take the category list's virtualisation and scrolling
                            with it. 560 holds the table at its full height over the after-picture's
                            minimum.
                        -->
                        <Setter Target="RoomTopRow.Height" Value="560" />
                        <!--
                            Spacing moves onto the rail's margin so the empty inspector column does
                            not leave an 11px gutter after the centre, and the stacked inspector
                            spans the same edges as the cards above it.
                        -->
                        <Setter Target="RoomGrid.ColumnSpacing" Value="0" />
                        <Setter Target="RailColumn.Width" Value="247" />
                        <Setter Target="RailCard.Margin" Value="0,0,11,0" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="InspectorCard.(Grid.Column)" Value="0" />
                        <Setter Target="InspectorCard.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="InspectorCard.(Grid.Row)" Value="1" />
                        <Setter Target="InspectorCard.Margin" Value="0,11,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                The width states assume a room row of about 560 DIPs: a full candidate table (268)
                over the after-picture's 150 floor. A 1280 x 690 window leaves about 510, and with the
                scroller off in Wide and Medium the after-picture was clipped rather than scrolled.
                Below 760 tall the table and the after-picture both give up height instead; each
                scrolls internally, so nothing is lost, only shown in a shorter window.
            -->
            <VisualStateGroup x:Name="HeightStates">
                <VisualState x:Name="Tall">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Short">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RowList.MaxHeight" Value="148" />
                        <Setter Target="AfterPictureRow.MinHeight" Value="112" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                Driven from code (SelectionFooter_SizeChanged), because the question is not how wide
                the window is but whether the footer's own contents fit, and those change with the
                numbers in them as well as with the column.
            -->
            <VisualStateGroup x:Name="FooterStates">
                <VisualState x:Name="FooterInline" />
                <VisualState x:Name="FooterStacked">
                    <VisualState.Setters>
                        <Setter Target="SelectionFooterGrid.RowSpacing" Value="8" />
                        <Setter Target="FooterRiskColumn.MinWidth" Value="0" />
                        <Setter Target="FooterRisk.(Grid.Row)" Value="1" />
                        <Setter Target="FooterRisk.(Grid.Column)" Value="0" />
                        <Setter Target="FooterRisk.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
