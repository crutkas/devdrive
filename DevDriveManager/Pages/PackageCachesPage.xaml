<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.PackageCachesPage"
    x:Name="CachesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Grid Margin="18,12,18,12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CacheToolbar.(Grid.Row)" Value="0" />
                        <Setter Target="CacheToolbar.(Grid.Column)" Value="1" />
                        <Setter Target="CacheToolbar.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CacheToolbar.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="10">
            <Grid ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Package caches" />
                <Grid
                    x:Name="CacheToolbar"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    ColumnSpacing="8"
                    HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <HyperlinkButton
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LearnWhatThisDoes"
                        Click="LearnAboutCacheMoves_Click"
                        Content="How cache moves work" />
                    <Button
                        Grid.Column="1"
                        Height="48"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="MoveAllButton"
                        Click="MoveAll_Click"
                        Content="{x:Bind Caches.MoveAllButtonText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.ShowMoveAllButton), Mode=OneWay}" />
                </Grid>
            </Grid>

            <!--
                A closed InfoBar is zero-height but still a visible child, so the stack's Spacing
                would still be added for it. Each one is collapsed while closed for that reason.
            -->
            <InfoBar
                AutomationProperties.AutomationId="CachesNoDevDriveNotice"
                IsClosable="False"
                IsOpen="{x:Bind Caches.ShowNoDevDriveNotice, Mode=OneWay}"
                Message="{x:Bind Caches.DevDriveNoticeMessage, Mode=OneWay}"
                Severity="Informational"
                Title="No Dev Drive"
                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.ShowNoDevDriveNotice), Mode=OneWay}" />
            <InfoBar
                AutomationProperties.AutomationId="MoveAllResult"
                IsClosable="True"
                IsOpen="{x:Bind Caches.ShowMoveAllResult, Mode=TwoWay}"
                Message="{x:Bind Caches.MoveAllResultText, Mode=OneWay}"
                Severity="{x:Bind MoveAllSeverity, Mode=OneWay}"
                Title="Package cache move"
                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.ShowMoveAllResult), Mode=OneWay}" />
            <InfoBar
                x:Name="CachesActionError"
                AutomationProperties.AutomationId="CachesActionError"
                Closed="CachesActionError_Closed"
                IsClosable="True"
                Severity="Error"
                Title="Package cache action failed"
                Visibility="Collapsed" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            SizeChanged="TableCard_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="14,4"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <SelectorBar
                                x:Name="CacheSelector"
                                Grid.Column="0"
                                AutomationProperties.AutomationId="CacheTabStrip"
                                AutomationProperties.Name="Which caches to show"
                                SelectionChanged="CacheSelector_SelectionChanged">
                                <SelectorBarItem
                                    x:Name="DetectedSelector"
                                    AutomationProperties.AutomationId="CacheTab_Detected"
                                    AutomationProperties.Name="{x:Bind DetectedTab.AutomationName, Mode=OneWay}"
                                    IsSelected="True"
                                    Text="{x:Bind DetectedTab.DisplayText, Mode=OneWay}" />
                                <SelectorBarItem
                                    x:Name="NotInstalledSelector"
                                    AutomationProperties.AutomationId="CacheTab_NotInstalled"
                                    AutomationProperties.Name="{x:Bind NotInstalledTab.AutomationName, Mode=OneWay}"
                                    Text="{x:Bind NotInstalledTab.DisplayText, Mode=OneWay}" />
                            </SelectorBar>

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CachesStatus"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="16,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="164" />
                                <ColumnDefinition Width="{x:Bind LocationColumnWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Ecosystem" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Location" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Redirected by" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Size" />
                            <TextBlock
                                Grid.Column="4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Status" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Action" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="2"
                        AutomationProperties.AutomationId="PackageCachesScrollViewer"
                        AutomationProperties.Name="Package caches in the selected group"
                        ContainerContentChanging="Caches_ContainerContentChanging"
                        ItemsSource="{x:Bind VisibleCaches}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="56" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackageCacheRowViewModel">
                                <StackPanel AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                    <Grid Padding="16,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="{Binding LocationColumnWidth, ElementName=CachesRoot}" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" VerticalAlignment="Center" ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8B7;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Header}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Description}" />
                                        </Grid>

                                        <!--
                                            LocationText, not ResolvedPath. ResolvedPath is where we
                                            found the cache and stays fixed so "Move back" knows where
                                            back is; this column has to follow the cache as it moves.
                                        -->
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind LocationText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind LocationText, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind RedirectedByText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind RedirectedByText, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind SizeText, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind MoveButtonAutomationId}"
                                                Click="MoveCache_Click"
                                                Content="Move"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveButton), Mode=OneWay}" />
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind MoveBackButtonAutomationId}"
                                                Command="{x:Bind MoveBackCommand}"
                                                Content="Move back"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveBackButton), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Margin="16,0,16,12"
                                        AutomationProperties.AutomationId="{x:Bind MapBlockAutomationId}"
                                        ColumnSpacing="7"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMapBlock), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="{x:Bind MapPathInputAutomationId}"
                                            AutomationProperties.Name="Cache folder path"
                                            PlaceholderText="Point us at this tool's cache folder&#x2026;"
                                            Text="{x:Bind MapPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="{x:Bind BrowseMapPathButtonAutomationId}"
                                            AutomationProperties.Name="Browse for cache folder"
                                            Click="BrowseForMapPath_Click"
                                            Content="Browse&#x2026;" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="{x:Bind MapPathButtonAutomationId}"
                                            Click="MapPath_Click"
                                            Content="Map path" />
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.AutomationId="{x:Bind MoveAndRemapButtonAutomationId}"
                                            Click="MoveAndRemap_Click"
                                            Content="Move &amp; remap"
                                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(CanMoveAndRemap), Mode=OneWay}" />
                                    </Grid>

                                    <Grid
                                        Margin="16,0,16,12"
                                        ColumnSpacing="8"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsMoving), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <ProgressBar
                                                AutomationProperties.AutomationId="{x:Bind MoveProgressAutomationId}"
                                                AutomationProperties.Name="Move progress"
                                                Maximum="100"
                                                Value="{x:Bind MoveProgressPercent, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind MoveProgressText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="{x:Bind CancelActiveMoveButtonAutomationId}"
                                            AutomationProperties.Name="Cancel move"
                                            Command="{x:Bind CancelActiveMoveCommand}"
                                            Content="Cancel" />
                                    </Grid>

                                    <TextBlock
                                        Margin="16,0,16,12"
                                        AutomationProperties.AutomationId="{x:Bind MoveResultAutomationId}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind MoveResultText, Mode=OneWay}"
                                        TextTrimming="None"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveResult), Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowEmptyState), Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            AutomationProperties.AutomationId="CachesEmptyState"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind EmptyStateText, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
        </Border>
    </Grid>
</Page>
