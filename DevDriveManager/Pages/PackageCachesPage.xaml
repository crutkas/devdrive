<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.PackageCachesPage"
    x:Name="CachesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Context strip. Same strip as Reclaim and Space, and carrying the same meaning: the bars
            show what each volume looks like after the caches still on the system drive have been
            moved off it. Moving a cache is not a delete, but from the system volume's point of view
            the bytes leave, which is exactly what the strip is for.

            The room's primary action rides on the strip for the reason the other two rooms do it:
            the thing you act on and the thing you act with belong together.
        -->
        <Grid
            Grid.Row="0"
            Padding="18,10"
            ColumnSpacing="14"
            BorderBrush="{ThemeResource SmDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                Grid.Column="0"
                AutomationProperties.AutomationId="CachesVolumeStrip"
                AutomationProperties.Name="Volumes on this machine"
                ItemsSource="{x:Bind VolumeStripEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="storage:VolumeStripEntry">
                        <controls:VolumeCard
                            AccentRole="{x:Bind AccentRole}"
                            IsSystemVolume="{x:Bind IsSystemVolume}"
                            ReclaimableBytes="{x:Bind ReclaimableBytes}"
                            Volume="{x:Bind Volume}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="MoveAllButton"
                Command="{x:Bind Caches.MoveAllCommand}"
                Content="{x:Bind Caches.MoveAllButtonText, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.ShowMoveAllButton), Mode=OneWay}" />
        </Grid>

        <!--
            The room. Three columns, same grammar as Reclaim and Space: the rail answers "what kind",
            the centre answers "which ones", the inspector answers "should I".

            One deliberate departure from Reclaim: the verb stays in the row rather than moving to
            the inspector. Reclaim ticks many rows and acts once, so its rows carry a checkbox and
            its action is global. Caches are a dozen rows each with exactly one obvious verb, so
            routing every Move through "select, then act" would add a click to every action and buy
            nothing. The inspector still answers the question Reclaim's does — what this is, where it
            is, where it would go, and what moving actually changes.
        -->
        <Grid
            Grid.Row="1"
            Padding="18,11"
            ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!--  ================= The caches themselves =================  -->
            <Border
                Grid.Column="0"
                SizeChanged="TableCard_SizeChanged"
                Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Tabs, not a title. The head has to say which half of the inventory is on screen
                        and let you switch, and a card title plus a rail said the first thing twice.
                        The chip on the right is the room's one-line answer: how much of what we found
                        is already where it should be.
                    -->
                    <Border Grid.Row="0" Padding="0" Style="{StaticResource SmCardHeadStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl
                                Grid.Column="0"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="CacheTabStrip"
                                AutomationProperties.Name="Which caches to show"
                                ItemsSource="{x:Bind Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CacheTabViewModel">
                                        <Grid>
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                Click="SelectTab_Click"
                                                Style="{StaticResource SmTabButtonStyle}"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Style="{x:Bind local:UiHelpers.TabTextStyle(IsSelected), Mode=OneWay}" Text="{x:Bind Title, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource SmTabCountTextStyle}" Text="{x:Bind Count, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>

                                            <!--
                                                The selected-tab underline. A sibling rather than a border
                                                on the button, so it can be inset from the padding and sit
                                                at the head's edge the way the spec draws it.
                                            -->
                                            <Rectangle
                                                Height="2.5"
                                                Margin="12,0,12,4"
                                                VerticalAlignment="Bottom"
                                                Fill="{ThemeResource SmAccentBrush}"
                                                RadiusX="2"
                                                RadiusY="2"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CachesWarning"
                                Style="{StaticResource SmCardSubTextStyle}"
                                Text="{x:Bind Caches.WarningMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="2"
                                Margin="0,0,14,0"
                                Style="{StaticResource SmChipStyle}">
                                <TextBlock
                                    AutomationProperties.AutomationId="CachesStatus"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        Move-all confirm and its receipt. Full width under the head rather than beside
                        the button on the strip, because the sentence it has to show names every cache
                        it is about to touch and would be unreadable at strip width.
                    -->
                    <StackPanel Grid.Row="1" Padding="14,0">
                        <Border
                            Margin="0,10,0,0"
                            Padding="12,9"
                            AutomationProperties.AutomationId="MoveAllConfirmPanel"
                            Background="{ThemeResource SmSelectionBrush}"
                            BorderBrush="{ThemeResource SmStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource SmTileCornerRadius}"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.IsConfirmingMoveAll), Mode=OneWay}">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    Style="{StaticResource SmKeyValueTextStyle}"
                                    Text="{x:Bind Caches.MoveAllConfirmBodyText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Button
                                        AutomationProperties.AutomationId="CancelMoveAllButton"
                                        Command="{x:Bind Caches.CancelMoveAllCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource SmCompactButtonStyle}" />
                                    <Button
                                        AutomationProperties.AutomationId="ConfirmMoveAllButton"
                                        Command="{x:Bind Caches.ConfirmMoveAllCommand}"
                                        Content="Move all"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,10,0,0"
                            AutomationProperties.AutomationId="MoveAllResult"
                            Style="{StaticResource SmCardSubTextStyle}"
                            Text="{x:Bind Caches.MoveAllResultText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Caches.ShowMoveAllResult), Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        Column header. Widths are shared with the row template below via the one
                        LocationColumnWidth number, which is what keeps the two aligned.
                    -->
                    <Border
                        Grid.Row="2"
                        Padding="14,7,14,7"
                        BorderBrush="{ThemeResource SmDividerBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="164" />
                                <ColumnDefinition Width="{x:Bind LocationColumnWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="ECOSYSTEM" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="LOCATION" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="REDIRECTED BY" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="SIZE" />
                            <TextBlock
                                Grid.Column="4"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="STATUS" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SmColumnHeaderTextStyle}"
                                Text="ACTION" />
                        </Grid>
                    </Border>

                    <ListView
                        Grid.Row="3"
                        AutomationProperties.AutomationId="PackageCachesScrollViewer"
                        AutomationProperties.Name="Package caches in the selected group"
                        ContainerContentChanging="Caches_ContainerContentChanging"
                        ItemsSource="{x:Bind VisibleCaches}"
                        SelectedItem="{x:Bind SelectedCache, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackageCacheRowViewModel">
                                <StackPanel
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    Opacity="{x:Bind RowOpacity}">
                                    <!--
                                        A Grid, not a horizontal StackPanel: a StackPanel hands its
                                        children unconstrained width, so the name cell never learns
                                        the column width and TextTrimming never engages on the long
                                        cache paths this room is full of.
                                    -->
                                    <Grid Padding="14,7,14,7" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="{Binding LocationColumnWidth, ElementName=CachesRoot}" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            A Grid, not a horizontal StackPanel. A StackPanel hands its
                                            children unconstrained width, so the name never learns the
                                            column width and TextTrimming never engages — "NuGet global
                                            packages" gets hard-clipped mid-word instead of ellipsised.

                                            The swatch is the only thing tying a row to the ecosystem
                                            colours used elsewhere in the room. It carries no meaning on
                                            its own, which is why the name sits beside it rather than
                                            behind it.
                                        -->
                                        <Grid
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle
                                                Grid.Column="0"
                                                Style="{x:Bind local:UiHelpers.SwatchStyle(CategoryIndex)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource SmCellTextStyle}"
                                                Text="{x:Bind Header}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Header}" />
                                        </Grid>

                                        <!--
                                            LocationText, not ResolvedPath. ResolvedPath is where we
                                            found the cache and stays fixed so "Move back" knows where
                                            back is; this column has to follow the cache as it moves.
                                        -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource SmMonoCellTextStyle}"
                                            Text="{x:Bind LocationText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind LocationText, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{x:Bind local:UiHelpers.RedirectCellStyle(IsRedirected), Mode=OneWay}"
                                            Text="{x:Bind RedirectedByText, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind RedirectedByText, Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind SizeText, Mode=OneWay}" />

                                        <Border Grid.Column="4" Style="{x:Bind local:UiHelpers.PillStyle(StatusKind), Mode=OneWay}">
                                            <TextBlock Style="{x:Bind local:UiHelpers.PillTextStyle(StatusKind), Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind MoveButtonAutomationId}"
                                                Command="{x:Bind MoveCommand}"
                                                Content="Move"
                                                Style="{StaticResource SmCompactButtonStyle}"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveButton), Mode=OneWay}" />
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind MoveBackButtonAutomationId}"
                                                Command="{x:Bind MoveBackCommand}"
                                                Content="Move back"
                                                Style="{StaticResource SmCompactButtonStyle}"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveBackButton), Mode=OneWay}" />
                                            <FontIcon
                                                AutomationProperties.Name="Already on Dev Drive"
                                                FontSize="14"
                                                Foreground="{ThemeResource SmGoodBrush}"
                                                Glyph="&#xE73E;"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsSet), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--
                                        Map / Move &amp; remap for a tool we did not detect. Kept in the
                                        row rather than behind the inspector so "Not installed" is an
                                        offer rather than a dead end — the whole point of the band.
                                    -->
                                    <Grid
                                        Margin="14,0,14,9"
                                        AutomationProperties.AutomationId="{x:Bind MapBlockAutomationId}"
                                        ColumnSpacing="7"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMapBlock), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="{x:Bind MapPathInputAutomationId}"
                                            AutomationProperties.Name="Cache folder path"
                                            PlaceholderText="Point us at this tool's cache folder&#x2026;"
                                            Text="{x:Bind MapPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="{x:Bind BrowseMapPathButtonAutomationId}"
                                            AutomationProperties.Name="Browse for cache folder"
                                            Click="BrowseForMapPath_Click"
                                            Content="Browse&#x2026;"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="{x:Bind MapPathButtonAutomationId}"
                                            Command="{x:Bind MapPathActionCommand}"
                                            Content="Map path"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.AutomationId="{x:Bind MoveAndRemapButtonAutomationId}"
                                            Command="{x:Bind MoveAndRemapCommand}"
                                            Content="Move &amp; remap"
                                            Style="{StaticResource SmCompactButtonStyle}"
                                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(CanMoveAndRemap), Mode=OneWay}" />
                                    </Grid>

                                    <!--  Inline confirm — Move, Map and Move &amp; remap all funnel through it.  -->
                                    <Border
                                        Margin="14,0,14,9"
                                        Padding="12,9"
                                        AutomationProperties.AutomationId="{x:Bind MoveConfirmPanelAutomationId}"
                                        Background="{ThemeResource SmSelectionBrush}"
                                        BorderBrush="{ThemeResource SmStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource SmTileCornerRadius}"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsConfirmingMove), Mode=OneWay}">
                                        <StackPanel Spacing="9">
                                            <TextBlock
                                                Style="{StaticResource SmKeyValueTextStyle}"
                                                Text="{x:Bind MoveConfirmBodyText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="7">
                                                <Button
                                                    AutomationProperties.AutomationId="{x:Bind CancelMoveButtonAutomationId}"
                                                    Command="{x:Bind CancelMoveCommand}"
                                                    Content="Cancel"
                                                    Style="{StaticResource SmCompactButtonStyle}" />
                                                <Button
                                                    AutomationProperties.AutomationId="{x:Bind ConfirmMoveButtonAutomationId}"
                                                    Command="{x:Bind ConfirmMoveCommand}"
                                                    Content="Confirm"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!--  Live per-row progress (files/bytes), off the UI thread via Progress&lt;T&gt;.  -->
                                    <Grid
                                        Margin="14,0,14,9"
                                        ColumnSpacing="8"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsMoving), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                            <ProgressBar
                                                AutomationProperties.AutomationId="{x:Bind MoveProgressAutomationId}"
                                                AutomationProperties.Name="Move progress"
                                                Maximum="100"
                                                Value="{x:Bind MoveProgressPercent, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource SmCardSubTextStyle}"
                                                Text="{x:Bind MoveProgressText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="{x:Bind CancelActiveMoveButtonAutomationId}"
                                            AutomationProperties.Name="Cancel move"
                                            Command="{x:Bind CancelActiveMoveCommand}"
                                            Content="Cancel"
                                            Style="{StaticResource SmCompactButtonStyle}" />
                                    </Grid>

                                    <!--  The receipt. Real, and reversible.  -->
                                    <TextBlock
                                        Margin="14,0,14,9"
                                        AutomationProperties.AutomationId="{x:Bind MoveResultAutomationId}"
                                        Style="{StaticResource SmCardSubTextStyle}"
                                        Text="{x:Bind MoveResultText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowMoveResult), Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  ================= Inspector =================  -->
            <Border Grid.Column="1" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CachesInspectorName"
                            Style="{StaticResource SmCardTitleTextStyle}"
                            Text="{x:Bind SelectedCache.Header, Mode=OneWay, FallbackValue='Nothing in this group'}" />
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,12" Spacing="4">
                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT THIS IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind SelectedCache.Description, Mode=OneWay, FallbackValue='Nothing in this group.'}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHERE IT IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="CachesInspectorPath"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorLocation, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHERE IT WOULD GO" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="CachesInspectorDestination"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorDestination, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT MOVING CHANGES" />
                            <TextBlock
                                AutomationProperties.AutomationId="CachesInspectorEffect"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorEffect, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        What moving actually does, pinned to the foot the way Space and Reclaim pin
                        theirs. It used to sit under the rail; with the rail gone this is the room's
                        only place for the question a first-time visitor asks before touching anything.
                    -->
                    <Border
                        Grid.Row="2"
                        Padding="13,9,13,10"
                        Background="{ThemeResource SmCardHeaderBrush}"
                        BorderBrush="{ThemeResource SmDividerBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <!--
                                Trimming is off here on purpose. SmCardSubTextStyle trims by default for
                                single-line captions; this one wraps, so wrapping should decide the height
                                rather than an ellipsis eating the last clause.
                            -->
                            <TextBlock
                                Style="{StaticResource SmCardSubTextStyle}"
                                TextTrimming="None"
                                TextWrapping="Wrap">
                                Moving copies a cache to your Dev Drive and repoints the tool at it. Nothing is deleted, and every move can be undone.
                            </TextBlock>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="LearnWhatThisDoes"
                                Padding="0"
                                Click="LearnAboutCacheMoves_Click"
                                Content="Learn what this does" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="CachesStatusBar"
            AutomationProperties.Name="Package caches status"
            Hints="Enter select &#xB7; Tab to actions" />
    </Grid>
</Page>
