<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.DrivesPage"
    x:Name="DrivesRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:storage="using:DevDriveStorage"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Context strip. The same strip as every other room, and here it is the subject rather than
            the context: this room is about the volumes themselves, so the tiles above the table and
            the rows in it are two views of one thing.

            The room's primary action rides on the strip because the thing you act on and the thing
            you act with belong together — and because "create another" is the only verb a room that
            otherwise just reads the machine has to offer.
        -->
        <Grid
            Grid.Row="0"
            Padding="18,10"
            ColumnSpacing="14"
            BorderBrush="{ThemeResource SmDividerBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl
                Grid.Column="0"
                AutomationProperties.AutomationId="DrivesVolumeStrip"
                AutomationProperties.Name="Volumes on this machine"
                ItemsSource="{x:Bind VolumeStripEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="storage:VolumeStripEntry">
                        <controls:VolumeCard
                            AccentRole="{x:Bind AccentRole}"
                            IsSystemVolume="{x:Bind IsSystemVolume}"
                            ReclaimableBytes="{x:Bind ReclaimableBytes}"
                            Volume="{x:Bind Volume}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="CreateDevDriveButton"
                Command="{x:Bind ViewModel.CreateDevDriveCommand}"
                Content="Create Dev Drive"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!--
            The room. Two columns, same grammar as Caches: the centre answers "which ones", the
            inspector answers "so what". No rail — this machine has a handful of volumes and a
            handful of filters, and a rail over two tabs would be a control with nothing to do.
        -->
        <Grid
            Grid.Row="1"
            Padding="18,11"
            ColumnSpacing="11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!--  ================= Volumes / filter drivers =================  -->
            <Grid Grid.Column="0" RowSpacing="11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    SizeChanged="TableCard_SizeChanged"
                    Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Tabs, not a title. Volumes and filter drivers are two subjects about the same
                        hardware, and a title would have to name one of them and then be wrong half
                        the time. The chip on the right is whichever tab's one-line answer applies.
                    -->
                    <Border Grid.Row="0" Padding="0" Style="{StaticResource SmCardHeadStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl
                                Grid.Column="0"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="DriveTabStrip"
                                AutomationProperties.Name="What to show"
                                ItemsSource="{x:Bind Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DriveTabViewModel">
                                        <Grid>
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                Click="SelectTab_Click"
                                                Style="{StaticResource SmTabButtonStyle}"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Style="{x:Bind local:UiHelpers.TabTextStyle(IsSelected), Mode=OneWay}" Text="{x:Bind Title, Mode=OneWay}" />
                                                    <TextBlock Style="{StaticResource SmTabCountTextStyle}" Text="{x:Bind Count, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>

                                            <!--
                                                The selected-tab underline. A sibling rather than a
                                                border on the button, so it can be inset from the
                                                padding and sit at the head's edge as the spec draws.
                                            -->
                                            <Rectangle
                                                Height="2.5"
                                                Margin="12,0,12,4"
                                                VerticalAlignment="Bottom"
                                                Fill="{ThemeResource SmAccentBrush}"
                                                RadiusX="2"
                                                RadiusY="2"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsSelected), Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DrivesSubhead"
                                Style="{StaticResource SmCardSubTextStyle}"
                                Text="Every fixed volume on this PC, and what is allowed to sit in the Dev Drive's write path."
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="2"
                                Margin="0,0,14,0"
                                Style="{StaticResource SmChipStyle}">
                                <TextBlock
                                    AutomationProperties.AutomationId="DrivesStatus"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--
                        Two column headers, one per tab. Both read the same NotesColumnWidth, which is
                        what keeps each header aligned with its own rows.
                    -->
                    <Border
                        Grid.Row="1"
                        Padding="14,7,14,7"
                        BorderBrush="{ThemeResource SmDividerBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid ColumnSpacing="12" Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowVolumes), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="188" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="{x:Bind NotesColumnWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="VOLUME" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="FORMAT" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="CAPACITY" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="FREE" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="DEV DRIVE" />
                                <TextBlock
                                    Grid.Column="5"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="NOTES" />
                            </Grid>

                            <Grid ColumnSpacing="12" Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowFilters), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="188" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="{x:Bind NotesColumnWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="FILTER" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="ALTITUDE" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="IN THE PATH" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource SmColumnHeaderTextStyle}"
                                    Text="WHAT IT DOES" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <!--  ================= Volumes =================  -->
                        <ListView
                            MaxHeight="300"
                            AutomationProperties.AutomationId="VolumesList"
                            AutomationProperties.Name="Fixed volumes on this PC"
                            ContainerContentChanging="Volumes_ContainerContentChanging"
                            ItemsSource="{x:Bind ViewModel.Volumes}"
                            SelectedItem="{x:Bind SelectedVolume, Mode=TwoWay}"
                            SelectionMode="Single"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowVolumes), Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:VolumeRowViewModel">
                                    <!--
                                        A Grid, not a horizontal StackPanel: a StackPanel hands its
                                        children unconstrained width, so the notes cell never learns
                                        the column width and TextTrimming never engages on the long
                                        VHD paths a note can carry.
                                    -->
                                    <Grid
                                        Padding="14,8,14,8"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="188" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="{Binding NotesColumnWidth, ElementName=DrivesRoot}" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            ColumnSpacing="9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Style="{x:Bind local:UiHelpers.SwatchStyle(CategoryIndex)}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource SmCellTextStyle}"
                                                Text="{x:Bind Header}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Header}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmCellTextStyle}"
                                            Text="{x:Bind FileSystemType}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind CapacityText}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind FreeText}" />

                                        <Border
                                            Grid.Column="4"
                                            Style="{x:Bind local:UiHelpers.PillStyle(DevDrivePillKind)}">
                                            <TextBlock
                                                AutomationProperties.AutomationId="{x:Bind DevDriveBadgeAutomationId}"
                                                Style="{x:Bind local:UiHelpers.PillTextStyle(DevDrivePillKind)}"
                                                Text="{x:Bind DevDrivePillText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmKeyValueTextStyle}"
                                            Text="{x:Bind NotesText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind NotesText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--  ================= Filter drivers =================  -->
                        <ListView
                            MaxHeight="300"
                            AutomationProperties.AutomationId="FiltersList"
                            AutomationProperties.Name="Filter drivers in the Dev Drive's write path"
                            ItemsSource="{x:Bind ViewModel.Trust.Filters}"
                            SelectionMode="None"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowFilters), Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterRowViewModel">
                                    <Grid
                                        Padding="14,8,14,8"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="188" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="{Binding NotesColumnWidth, ElementName=DrivesRoot}" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource SmMonoCellTextStyle}"
                                            Text="{x:Bind Name}"
                                            ToolTipService.ToolTip="{x:Bind Name}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmNumericCellTextStyle}"
                                            Text="{x:Bind AltitudeText}" />

                                        <Border Grid.Column="2" Style="{x:Bind local:UiHelpers.PillStyle(StatusKind)}">
                                            <TextBlock Style="{x:Bind local:UiHelpers.PillTextStyle(StatusKind)}" Text="{x:Bind StatusText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SmKeyValueTextStyle}"
                                            Text="{x:Bind Description}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Description}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!--
                            The filters tab with nothing to list. One line only — the explanation and
                            the button that fixes it are in the I/O path card directly below, and
                            saying it twice would read as two separate problems.
                        -->
                        <TextBlock
                            Margin="14,14,14,16"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="FiltersEmptyNote"
                            Style="{StaticResource SmCardSubTextStyle}"
                            Text="Nothing to list until the filters have been read."
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowFilterEmptyState), Mode=OneWay}" />
                    </Grid>
                </Grid>
                </Border>

                <!--
                    The I/O path. The table above states the facts; this states what they mean — a
                    build tool's write descends through every attached filter before it lands, and the
                    reason a Dev Drive is fast is visible here as gaps in that descent, which six rows
                    of a table cannot show.

                    It also carries the room's slack. A table card sized to its rows with an empty half
                    page under it reads as a bug; a diagram that grows into that space does not.
                -->
                <Border Grid.Row="1" Style="{StaticResource SmCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardTitleTextStyle}"
                                    Text="The I/O path, in altitude order" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmCardSubTextStyle}"
                                    Text="every write from a build tool passes through this, top to bottom"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Grid
                            Grid.Row="1"
                            Padding="14,12,14,12"
                            ColumnSpacing="16"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(HasIoPath), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl
                                Grid.Column="0"
                                AutomationProperties.AutomationId="IoPathLeft"
                                AutomationProperties.Name="The write path, first half"
                                ItemsSource="{x:Bind IoPathLeft, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IoPathNodeViewModel">
                                        <StackPanel>
                                            <Rectangle Style="{StaticResource SmStackArrowStyle}" Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowArrow)}" />
                                            <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{x:Bind local:UiHelpers.StackNodeStyle(Kind)}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Style="{x:Bind local:UiHelpers.StackNodeTitleStyle(Kind)}"
                                                        Text="{x:Bind Title}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SmStackNodeCaptionTextStyle}"
                                                        Text="{x:Bind Caption}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl
                                Grid.Column="1"
                                AutomationProperties.AutomationId="IoPathRight"
                                AutomationProperties.Name="The write path, second half"
                                ItemsSource="{x:Bind IoPathRight, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IoPathNodeViewModel">
                                        <StackPanel>
                                            <Rectangle Style="{StaticResource SmStackArrowStyle}" Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowArrow)}" />
                                            <Border AutomationProperties.Name="{x:Bind AutomationName}" Style="{x:Bind local:UiHelpers.StackNodeStyle(Kind)}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Style="{x:Bind local:UiHelpers.StackNodeTitleStyle(Kind)}"
                                                        Text="{x:Bind Title}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SmStackNodeCaptionTextStyle}"
                                                        Text="{x:Bind Caption}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!--
                            No elevated read yet. What the diagram would say, and the one button that
                            gets us there — read-only, once, without restarting the app as admin.
                        -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="18,20,18,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            Spacing="10"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ShowIoPathEmptyState), Mode=OneWay}">
                            <TextBlock
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="Which filter drivers actually run on a volume is a privileged query, so we cannot draw this path yet. Reading it is read-only and takes one prompt."
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="SeeFiltersButton"
                                Command="{x:Bind ViewModel.Trust.SeeFiltersCommand}"
                                Content="See filter drivers"
                                IsEnabled="{x:Bind local:UiHelpers.Not(ViewModel.Trust.IsInspecting), Mode=OneWay}"
                                Style="{StaticResource SmCompactButtonStyle}" />
                            <TextBlock
                                HorizontalTextAlignment="Center"
                                AutomationProperties.AutomationId="SeeFiltersNote"
                                Style="{StaticResource SmCardSubTextStyle}"
                                Text="{x:Bind ViewModel.Trust.CouldNotReadFiltersNote}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.CouldNotReadFilters), Mode=OneWay}" />
                        </StackPanel>

                        <!--
                            The foot explains how to read the diagram, so it is only useful once the
                            diagram exists. With no path drawn it reads as a caption with no subject.
                        -->
                        <Border
                            Grid.Row="2"
                            Padding="14,9,14,10"
                            Background="{ThemeResource SmCardHeaderBrush}"
                            BorderBrush="{ThemeResource SmDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(HasIoPath), Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="Lower altitude runs closer to the filesystem. Skipping WdFilter is the single biggest reason a Dev Drive builds faster — and the single biggest reason to put only source and caches on it."
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= Inspector =================  -->
            <Border Grid.Column="1" Style="{StaticResource SmCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SmCardHeadStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DrivesInspectorName"
                            Style="{StaticResource SmCardTitleTextStyle}"
                            Text="{x:Bind InspectorTitle, Mode=OneWay}" />
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,12" Spacing="4">
                            <!--
                                Two numbers first, because the question this room ends on is whether
                                there is room for what you were about to put somewhere, and a sentence
                                is a slow way to answer it.
                            -->
                            <Grid Margin="0,0,0,12" ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SmTierCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SmMetricLabelTextStyle}" Text="FREE ON DEV DRIVE" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="DrivesFreeOnDevDrive"
                                            Style="{StaticResource SmMetricValueTextStyle}"
                                            Text="{x:Bind DevDriveFreeText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SmTierCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SmMetricLabelTextStyle}" Text="FREE ON SYSTEM" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="DrivesFreeOnSystem"
                                            Style="{StaticResource SmMetricValueTextStyle}"
                                            Text="{x:Bind SystemFreeText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT THIS IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="DrivesInspectorWhat"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorWhatThisIs, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="HOW FULL IT IS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="DrivesInspectorCapacity"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorCapacity, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="WHAT THE FORMAT MEANS" />
                            <TextBlock
                                Margin="0,0,0,10"
                                AutomationProperties.AutomationId="DrivesInspectorFormat"
                                Style="{StaticResource SmKeyValueTextStyle}"
                                Text="{x:Bind InspectorFormat, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SmSectionLabelTextStyle}" Text="MAKING ROOM FOR ANOTHER" />
                            <TextBlock
                                Style="{StaticResource SmKeyValueTextStyle}"
                                TextWrapping="Wrap">
                                Reclaim before you repartition. A shrink can only use free space that is contiguous and at the end of the volume, and deleting first is what makes that space exist.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        The two links that leave this app, pinned to the foot the way every other room
                        pins its "what does this actually do". Windows owns partitioning and Defender
                        policy; pretending otherwise would be the dishonest option.
                    -->
                    <Border
                        Grid.Row="2"
                        Padding="13,9,13,10"
                        Background="{ThemeResource SmCardHeaderBrush}"
                        BorderBrush="{ThemeResource SmDividerBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="2">
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="ManageInStorageButton"
                                Command="{x:Bind ViewModel.ManageInStorageCommand}"
                                Content="Manage in Storage settings" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="OpenWindowsSecurityLink"
                                Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}"
                                Content="Dev Drive protection in Windows Security" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  The room's closing edge: live facts on the left, keyboard hints on the right.  -->
        <controls:RoomStatusBar
            x:Name="StatusBar"
            Grid.Row="2"
            AutomationProperties.AutomationId="DrivesStatusBar"
            AutomationProperties.Name="Drives status"
            Hints="Enter select &#xB7; Tab to actions" />
    </Grid>
</Page>
