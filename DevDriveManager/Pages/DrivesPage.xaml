<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.DrivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="DrivesScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Padding="36,24,36,40"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!--  Page header  -->
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Drives" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Your Dev Drive at a glance, and every fixed volume on this PC." />
            </StackPanel>

            <!--  ── Dev Drive hero (only when one exists) ──  -->
            <StackPanel Spacing="8" Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.HasDevDrive), Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dev Drive" />

                <Border
                    x:Name="DriveHealthCard"
                    AutomationProperties.AutomationId="DriveHealthCard"
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE930;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.DriveHealth.HeaderText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DriveHealth.DescriptionText, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="DriveHealthPerformanceMode"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DriveHealth.PerformanceModeLineText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="10,2,10,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DriveHealth.HealthPillText, Mode=OneWay}" />
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <ProgressBar
                                AutomationProperties.AutomationId="DriveCapacityBar"
                                AutomationProperties.Name="Dev Drive capacity used"
                                Maximum="100"
                                Value="{x:Bind ViewModel.DriveHealth.CapacityPercent, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.DriveHealth.CapacityCaption, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.Trust.IsInspecting, Mode=OneWay}"
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.IsInspecting), Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="SeeFiltersButton"
                                    AutomationProperties.Name="See filter drivers (needs admin)"
                                    Command="{x:Bind ViewModel.Trust.SeeFiltersCommand}"
                                    IsEnabled="{x:Bind local:UiHelpers.IsNotBusy(ViewModel.Trust.IsInspecting), Mode=OneWay}"
                                    ToolTipService.ToolTip="Runs fsutil devdrv query behind a one-time UAC prompt and shows the filter drivers in Trust &amp; filters below — no app restart."
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.ShowSeeFilters), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE72E;" />
                                        <TextBlock Text="See filter drivers" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="(needs admin)" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.AutomationId="ManageInStorageButton"
                                    Command="{x:Bind ViewModel.ManageInStorageCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                        <TextBlock Text="Manage in Storage" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.CouldNotReadFilters), Mode=OneWay}">
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    AutomationProperties.AutomationId="SeeFiltersNote"
                                    MaxWidth="360"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Trust.CouldNotReadFiltersNote, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Trust + filters detail (elevated) / elevation hint (unelevated)  -->
                <controls:SettingsExpander
                    AutomationProperties.AutomationId="TrustExpander"
                    Description="Trust state, Defender performance mode, and filter drivers"
                    Header="Trust and filters"
                    IsExpanded="{x:Bind ViewModel.Trust.HasTrustDetail, Mode=OneWay}"
                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.HasTrustDetail), Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Trust state">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Trust.TrustStateText, Mode=OneWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Defender performance mode">
                            <StackPanel HorizontalAlignment="Right" Spacing="4">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.Trust.PerformanceModeText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    AutomationProperties.AutomationId="ProtectionStatusText"
                                    MaxWidth="420"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.Trust.ProtectionStatusText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="TurnOnPerformanceModeLink"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.EnablePerformanceModeCommand}"
                                    Content="Turn on performance mode"
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.CanTurnOnPerformanceMode), Mode=OneWay}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="OpenWindowsSecurityLink"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}"
                                    Content="Open Windows Security"
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.IsPerformanceModePolicyControlled), Mode=OneWay}" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.Trust.IsPerformanceModePolicyControlled), Mode=OneWay}">
                                    <FontIcon
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE72E;" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="PerformanceModePolicyNote"
                                        MaxWidth="360"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Trust.PerformanceModePolicyNote, Mode=OneWay}"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Filters attached">
                            <TextBlock
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Trust.AttachedFiltersText, Mode=OneWay}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="Filters allowed">
                            <TextBlock
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Trust.AllowedFiltersText, Mode=OneWay}"
                                TextAlignment="Right"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <!--  No Dev Drive yet — gentle pointer to Create  -->
            <InfoBar
                AutomationProperties.AutomationId="NoDevDriveBar"
                IsClosable="False"
                IsOpen="True"
                Message="A Dev Drive is a ReFS volume tuned for developer workloads (repos, package caches, build output). Create one to get faster file I/O and Defender performance mode."
                Severity="Informational"
                Title="No Dev Drive yet"
                Visibility="{x:Bind local:UiHelpers.InvertBoolToVisibility(ViewModel.HasDevDrive), Mode=OneWay}" />

            <!--  ── All volumes (banded) ──  -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="All volumes on this PC" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="18"
                        Height="18"
                        AutomationProperties.Name="Loading volumes"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </Grid>

                <ItemsControl
                    AutomationProperties.AutomationId="VolumesList"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VolumeRowViewModel">
                            <controls:SettingsCard
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Background="{x:Bind local:UiHelpers.BandBrush(BandAlt)}"
                                Description="{x:Bind Description}"
                                Header="{x:Bind Header}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Foreground="{x:Bind local:UiHelpers.DriveGlyphBrush(IsDevDrive)}" Glyph="{x:Bind GlyphCode}" />
                                </controls:SettingsCard.HeaderIcon>
                                <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <Border
                                        Padding="10,2,10,3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind DevDriveBadgeAutomationId}"
                                        AutomationProperties.Name="Dev Drive"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsDevDrive)}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Dev Drive" />
                                    </Border>
                                    <Border
                                        Padding="10,2,10,3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Trusted"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsTrusted)}">
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Trusted" />
                                    </Border>
                                    <Border
                                        Padding="10,2,10,3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="VHD backed"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ToolTipService.ToolTip="{x:Bind VhdFilePath}"
                                        Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsVhd)}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="VHD" />
                                    </Border>
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
