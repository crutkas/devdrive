<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.DashboardPage"
    x:Name="OverviewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevDriveManager"
    xmlns:vm="using:DevDriveManager.ViewModels">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="OverviewHeroWashBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFDDEBFB" />
                        <GradientStop Offset="1" Color="#00DDEBFB" />
                    </LinearGradientBrush>
                    <BitmapImage x:Key="OverviewHeroImage" UriSource="ms-appx:///Assets/OverviewHero.png" />
                    <LinearGradientBrush x:Key="OverviewOpportunityBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFE8F1FC" />
                        <GradientStop Offset="0.55" Color="#B3FFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="OverviewHeroWashBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FF1A2638" />
                        <GradientStop Offset="1" Color="#001A2638" />
                    </LinearGradientBrush>
                    <BitmapImage x:Key="OverviewHeroImage" UriSource="ms-appx:///Assets/OverviewHeroDark.png" />
                    <LinearGradientBrush x:Key="OverviewOpportunityBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF1E2B3D" />
                        <GradientStop Offset="0.55" Color="#0DFFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="OverviewHeroWashBrush" Color="Transparent" />
                    <!-- No decorative art in high contrast. -->
                    <BitmapImage x:Key="OverviewHeroImage" />
                    <SolidColorBrush x:Key="OverviewOpportunityBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="OverviewSectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <!-- A default button laid out like a card: icon tile, two lines of text, a chevron. -->
            <Style x:Key="OverviewQuickActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroArt.Visibility" Value="Visible" />
                        <Setter Target="QuickActions.RowSpacing" Value="0" />
                        <Setter Target="QuickSpace.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuickReclaim.(Grid.Row)" Value="0" />
                        <Setter Target="QuickReclaim.(Grid.Column)" Value="1" />
                        <Setter Target="QuickReclaim.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuickCaches.(Grid.Row)" Value="0" />
                        <Setter Target="QuickCaches.(Grid.Column)" Value="2" />
                        <Setter Target="QuickCaches.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer AutomationProperties.AutomationId="OverviewScrollViewer"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- A soft tint behind the hero that fades into the page. -->
                <Rectangle Grid.RowSpan="2" Height="300" VerticalAlignment="Top"
                           Fill="{ThemeResource OverviewHeroWashBrush}"
                           IsHitTestVisible="False" />

                <!--
                    Decorative Bloom banner: it bleeds off the right edge and fades into the page, so the
                    title keeps clean space on the left. Screen readers skip it; hidden on narrow windows.
                -->
                <Image x:Name="HeroArt" Grid.RowSpan="2" Visibility="Collapsed"
                       Source="{ThemeResource OverviewHeroImage}"
                       Height="260" Stretch="Uniform"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       IsHitTestVisible="False"
                       AutomationProperties.AccessibilityView="Raw" />

                <!-- ============ Hero: title and the one action this room owns ============ -->
                <Grid Margin="18,20,18,12" MinHeight="180">
                    <StackPanel VerticalAlignment="Center" Spacing="16">
                        <TextBlock Text="Home"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   AutomationProperties.AutomationId="PageTitle"
                                   AutomationProperties.HeadingLevel="Level1" />

                        <!--
                            Overview scans the whole machine, which is the same act the Reclaim room performs, so
                            the button runs the same command and keeps the same name as Reclaim's.
                        -->
                        <Grid x:Name="ScanToolbar" HorizontalAlignment="Left">
                            <Button x:Name="ScanButton" Height="40" MinWidth="128"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="ScanBarScanButton"
                                    AutomationProperties.Name="Scan this PC"
                                    Click="ScanButton_Click"
                                    Visibility="{x:Bind local:UiHelpers.InvertBoolToVisibility(Reclaim.IsScanning), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Scan this PC" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelScanButton" Height="40" MinWidth="128"
                                    AutomationProperties.AutomationId="OverviewCancelScan"
                                    AutomationProperties.Name="Cancel scan"
                                    Click="CancelScanButton_Click"
                                    Visibility="{x:Bind local:UiHelpers.BoolToVisibility(Reclaim.IsScanning), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16"
                                                  IsActive="{x:Bind Reclaim.IsScanning, Mode=OneWay}" />
                                    <TextBlock Text="Cancel" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="18,0,18,36" Spacing="4">

                <!--
                    The drives need no heading: the cards say what they are. The Grid carries the
                    section's name because ItemsRepeater has no automation peer of its own.
                -->
                <Grid AutomationProperties.AutomationId="OverviewDrives"
                      AutomationProperties.Name="Your drives">
                <ItemsRepeater ItemsSource="{x:Bind DriveCards}"
                               AutomationProperties.AutomationId="OverviewDriveList"
                               AutomationProperties.Name="Your drives">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MaximumRowsOrColumns="{x:Bind DriveColumns, Mode=OneWay}"
                                           MinItemWidth="300"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriveCardViewModel">
                            <!--
                                A Grid rather than a Border at the root: Border has no automation peer,
                                so the card's id and name would not reach UI Automation.
                            -->
                            <Grid Padding="16" RowSpacing="12" CornerRadius="8" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                  AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Name, role, and the Dev Drive badge. -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center"
                                            Padding="8,2" CornerRadius="10" BorderThickness="1"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(HasBadge)}">
                                        <TextBlock Text="{x:Bind BadgeText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </Grid>

                                <!-- Free of total: the one figure the card exists to show. -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind FreeText}"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind OfText}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Used and free, then what is used. Red, with a way out, when low. -->
                                <StackPanel Grid.Row="2" Spacing="8"
                                            Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsSizeKnown)}">
                                    <Grid Height="8" CornerRadius="4"
                                          Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind UsedWidth}" />
                                            <ColumnDefinition Width="{x:Bind FreeWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4,0,0,4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind local:UiHelpers.InvertBoolToVisibility(IsLow)}" />
                                        <Border CornerRadius="4,0,0,4"
                                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsLow)}" />
                                    </Grid>

                                    <!-- Fixed height so a card with the link is as tall as one without. -->
                                    <Grid Height="20" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                      ToolTipService.ToolTip="{x:Bind LowText}"
                                                      Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsLow)}" />
                                            <TextBlock Text="{x:Bind UsedText}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <HyperlinkButton Grid.Column="1" Content="Free up space" Tag="reclaim"
                                                         Padding="0" VerticalAlignment="Center"
                                                         Click="Room_Click"
                                                         AutomationProperties.AutomationId="{x:Bind ActionAutomationId}"
                                                         Visibility="{x:Bind local:UiHelpers.BoolToVisibility(IsLow)}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </Grid>

                <!-- ============ Opportunities ============ -->
                <StackPanel Margin="1,32,0,8" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Opportunities" VerticalAlignment="Center"
                               Style="{StaticResource OverviewSectionHeaderStyle}"
                               AutomationProperties.AutomationId="OverviewOpportunities" />
                    <InfoBadge Value="{x:Bind OpportunityCount, Mode=OneWay}" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw"
                               Visibility="{x:Bind local:UiHelpers.BoolToVisibility(HasOpportunities), Mode=OneWay}" />
                </StackPanel>

                <ItemsRepeater ItemsSource="{x:Bind Opportunities}"
                               AutomationProperties.AutomationId="OpportunitiesList"
                               AutomationProperties.Name="Opportunities">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttentionSignalViewModel">
                            <Grid Padding="20,16" ColumnSpacing="16" CornerRadius="8" BorderThickness="1"
                                  Background="{ThemeResource OverviewOpportunityBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                  AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48" CornerRadius="8" VerticalAlignment="Center"
                                      Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="{x:Bind HeaderGlyph}" FontSize="22"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="16"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Impact}" VerticalAlignment="Center"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind local:UiHelpers.BoolToVisibility(HasImpactSize)}" />
                                <Button Grid.Column="3" Content="{x:Bind ActionText}" Tag="{x:Bind RoomTag}"
                                        MinWidth="140" VerticalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="Room_Click"
                                        AutomationProperties.AutomationId="{x:Bind RoomButtonAutomationId}"
                                        AutomationProperties.Name="{x:Bind RoomButtonAutomationName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Grid Padding="20,16" ColumnSpacing="16" CornerRadius="8" BorderThickness="1"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      AutomationProperties.AutomationId="OverviewOpportunitiesEmpty"
                      AutomationProperties.Name="{x:Bind EmptyTitle, Mode=OneWay}"
                      Visibility="{x:Bind local:UiHelpers.InvertBoolToVisibility(HasOpportunities), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48" CornerRadius="8" VerticalAlignment="Center"
                          Background="{ThemeResource SystemFillColorSuccessBrush}">
                        <FontIcon Glyph="&#xE73E;" FontSize="22"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind EmptyTitle, Mode=OneWay}" FontSize="16"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind EmptyDetail, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- ============ Quick actions ============ -->
                <TextBlock Margin="1,32,0,8" Text="Quick actions"
                           Style="{StaticResource OverviewSectionHeaderStyle}"
                           AutomationProperties.AutomationId="OverviewQuickActions" />

                <!-- Stacked on narrow windows; one row of three from the WideState up. -->
                <Grid x:Name="QuickActions" ColumnSpacing="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="QuickSpace" Grid.ColumnSpan="3" Tag="space" Click="Room_Click"
                            Style="{StaticResource OverviewQuickActionStyle}"
                            AutomationProperties.AutomationId="OverviewQuick_space"
                            AutomationProperties.Name="See what takes space: open Space">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" CornerRadius="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                                <FontIcon Glyph="&#xE9D5;" FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="See what takes space" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Find the folders that use the most space" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Button x:Name="QuickReclaim" Grid.Row="1" Grid.ColumnSpan="3" Tag="reclaim" Click="Room_Click"
                            Style="{StaticResource OverviewQuickActionStyle}"
                            AutomationProperties.AutomationId="OverviewQuick_reclaim"
                            AutomationProperties.Name="Free up space: open Reclaim">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" CornerRadius="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                                <FontIcon Glyph="&#xEA99;" FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Free up space" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Remove files you don't need" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Button x:Name="QuickCaches" Grid.Row="2" Grid.ColumnSpan="3" Tag="caches" Click="Room_Click"
                            Style="{StaticResource OverviewQuickActionStyle}"
                            AutomationProperties.AutomationId="OverviewQuick_caches"
                            AutomationProperties.Name="Manage caches: open Caches">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" CornerRadius="8">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                                <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Manage caches" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Move package caches to a Dev Drive" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
