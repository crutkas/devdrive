<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DevDriveManager.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Padding="36,24,36,40"
            HorizontalAlignment="Stretch"
            Spacing="20">

            <!--  Page header  -->
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="The app follows your system theme and just works — only a few things to tune." />
            </StackPanel>

            <!--  ── Appearance ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
                <controls:SettingsCard
                    Description="Follow your system theme, or pin the app to Light or Dark."
                    Header="Theme">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE771;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeSelector"
                        AutomationProperties.AutomationId="ThemeSelector"
                        AutomationProperties.Name="App theme"
                        MinWidth="160"
                        SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionSystem" Content="System default" Tag="Default" />
                        <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionLight" Content="Light" Tag="Light" />
                        <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionDark" Content="Dark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!--  ── Detection ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Detection" />
                <controls:SettingsCard
                    Description="Dev Drive Manager scans your fixed volumes and known package managers each time it loads. Nothing runs in the background."
                    Header="How detection works">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE773;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.AutomationId="RescanButton"
                        Command="{x:Bind ViewModel.LoadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="Rescan now" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard>
            </StackPanel>

            <!--  ── Moving caches ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Moving caches" />
                <controls:SettingsCard
                    Description="Moving a package cache copies it to your Dev Drive and repoints the tool's per-user environment variable. Nothing is deleted, and every move is reversible from the Package caches page."
                    Header="What moving does">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8DE;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.AutomationId="LearnWhatThisDoes"
                        Click="LearnAboutCacheMoves_Click"
                        Content="Learn what this does" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  ── Dev Drive ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dev Drive" />
                <controls:SettingsCard
                    Description="Create a new ReFS Dev Drive, or manage your drives in Windows."
                    Header="Manage Dev Drives">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="SettingsCreateButton"
                            Command="{x:Bind ViewModel.CreateDevDriveCommand}"
                            Content="Create Dev Drive" />
                        <Button
                            AutomationProperties.AutomationId="SettingsManageInStorageButton"
                            Command="{x:Bind ViewModel.ManageInStorageCommand}"
                            Content="Open Storage settings" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Defender performance mode is the biggest factor in your Dev Drive's real-workload advantage. Manage it in Windows Security."
                    Header="Defender performance mode">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.AutomationId="SettingsOpenWindowsSecurityButton"
                        Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}"
                        Content="Open Windows Security" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  ── Benchmarks ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Benchmarks" />
                <controls:SettingsExpander
                    AutomationProperties.AutomationId="AboutBenchmarksExpander"
                    Description="What the on-demand build benchmarks actually measure."
                    Header="About the benchmarks">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Suite.SuiteHonestyLine, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>

            <!--  ── About ──  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                <controls:SettingsExpander
                    AutomationProperties.AutomationId="AboutAppExpander"
                    Description="{x:Bind AppVersionText}"
                    Header="Dev Drive Manager">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Source">
                            <HyperlinkButton
                                AutomationProperties.AutomationId="RepoLink"
                                Content="github.com/crutkas/devdrive"
                                NavigateUri="https://github.com/crutkas/devdrive" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="A Dev Drive is a ReFS volume tuned for developer workloads. This app detects Dev Drives, moves package-manager caches onto them (reversibly, per-user, no admin), and benchmarks real build workloads on demand."
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
