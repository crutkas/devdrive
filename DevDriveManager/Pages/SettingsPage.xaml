<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <!-- WinUI Gallery Pages/SettingsPage.xaml: 4px cards, section margin 1,30,0,6. -->
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,30,0,6" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Margin" Value="36,0,36,36" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer AutomationProperties.AutomationId="SettingsScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <Border x:Name="SettingsContent" Margin="16,0,16,36">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
                    <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <toolkit:SettingsCard Header="App theme" Description="Use the Windows theme or choose a light or dark appearance.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeSelector" MinWidth="160"
                                  AutomationProperties.AutomationId="ThemeSelector" AutomationProperties.Name="App theme"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionSystem" Content="System default" Tag="Default" />
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionLight" Content="Light" Tag="Light" />
                            <ComboBoxItem AutomationProperties.AutomationId="ThemeOptionDark" Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <TextBlock Text="Overview and signals" Style="{StaticResource SettingsSectionHeaderStyle}"
                               AutomationProperties.AutomationId="SignalSettingsHead" />
                    <toolkit:SettingsCard Header="Low free-space warning" Description="Show a signal when a volume falls below this threshold.">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="LowFreeCombo" MinWidth="160"
                                  AutomationProperties.AutomationId="LowFreeCombo" AutomationProperties.Name="Low free space threshold"
                                  SelectionChanged="LowFreeCombo_SelectionChanged">
                            <ComboBoxItem AutomationProperties.AutomationId="LowFree10" Content="10%" Tag="10" />
                            <ComboBoxItem AutomationProperties.AutomationId="LowFree15" Content="15%" Tag="15" />
                            <ComboBoxItem AutomationProperties.AutomationId="LowFree20" Content="20%" Tag="20" />
                            <ComboBoxItem AutomationProperties.AutomationId="LowFree25" Content="25%" Tag="25" />
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsExpander Header="Package-cache signals" Description="Watch for caches outside your Dev Drive."
                                             AutomationProperties.AutomationId="CacheSignalsExpander"
                                             AutomationProperties.Name="Package-cache signals">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7B8;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch AutomationProperties.AutomationId="WatchCachesToggle"
                                      AutomationProperties.Name="Watch for caches landing off your Dev Drive"
                                      IsOn="{x:Bind WatchCachesOffDevDrive, Mode=TwoWay}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard Header="Combine cache signals after">
                                <ComboBox x:Name="RollupCombo" MinWidth="160"
                                          AutomationProperties.AutomationId="RollupCombo" AutomationProperties.Name="Combine cache signals after"
                                          SelectionChanged="RollupCombo_SelectionChanged">
                                    <ComboBoxItem AutomationProperties.AutomationId="Rollup2" Content="2 caches" Tag="2" />
                                    <ComboBoxItem AutomationProperties.AutomationId="Rollup3" Content="3 caches" Tag="3" />
                                    <ComboBoxItem AutomationProperties.AutomationId="Rollup5" Content="5 caches" Tag="5" />
                                    <ComboBoxItem AutomationProperties.AutomationId="RollupNever" Content="Never" Tag="0" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <TextBlock Text="Free-space history" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <toolkit:SettingsExpander Header="Record free space over time"
                                             Description="Keep a reading per volume every 30 minutes when Overview loads."
                                             AutomationProperties.AutomationId="HistorySettingsExpander"
                                             AutomationProperties.Name="Free-space history">
                        <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE81C;" /></toolkit:SettingsExpander.HeaderIcon>
                        <ToggleSwitch AutomationProperties.AutomationId="RecordHistoryToggle"
                                      AutomationProperties.Name="Record free space over time"
                                      IsOn="{x:Bind RecordFreeSpaceHistory, Mode=TwoWay}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard Header="Keep readings for" Description="Older readings are removed the next time Overview loads.">
                                <ComboBox x:Name="RetentionCombo" MinWidth="160"
                                          AutomationProperties.AutomationId="RetentionCombo" AutomationProperties.Name="Keep free space readings for"
                                          SelectionChanged="RetentionCombo_SelectionChanged">
                                    <ComboBoxItem AutomationProperties.AutomationId="Retention30" Content="30 days" Tag="30" />
                                    <ComboBoxItem AutomationProperties.AutomationId="Retention90" Content="90 days" Tag="90" />
                                    <ComboBoxItem AutomationProperties.AutomationId="Retention365" Content="1 year" Tag="365" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="Saved history">
                                <toolkit:SettingsCard.Description>
                                    <TextBlock AutomationProperties.AutomationId="HistorySummary"
                                               Text="{x:Bind HistorySummaryText, Mode=OneWay}" TextWrapping="Wrap" />
                                </toolkit:SettingsCard.Description>
                                <Button Content="Clear history" AutomationProperties.AutomationId="ClearHistoryButton"
                                        AutomationProperties.Name="Clear saved free-space history"
                                        IsEnabled="{x:Bind HasHistory, Mode=OneWay}" Click="ClearHistory_Click" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <TextBlock Text="Drives and machine" Style="{StaticResource SettingsSectionHeaderStyle}"
                               AutomationProperties.AutomationId="MachineSettingsHead" />
                    <toolkit:SettingsCard Header="Default creation method">
                        <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEDA2;" /></toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CreationMethodCombo" MinWidth="160"
                                  AutomationProperties.AutomationId="CreationMethodCombo" AutomationProperties.Name="Default Dev Drive creation method"
                                  SelectionChanged="CreationMethodCombo_SelectionChanged">
                            <ComboBoxItem AutomationProperties.AutomationId="MethodResize" Content="Resize a volume" Tag="Resize" />
                            <ComboBoxItem AutomationProperties.AutomationId="MethodVhdx" Content="New VHDX" Tag="Vhdx" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <TextBlock Text="About" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <toolkit:SettingsExpander Header="DevDriveManager"
                                             AutomationProperties.AutomationId="AboutSettingsExpander"
                                             AutomationProperties.Name="About DevDriveManager">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <ImageIcon Source="ms-appx:///Assets/AppIcon.ico" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <TextBlock AutomationProperties.AutomationId="AppVersionLine" Text="{x:Bind AppVersionText}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard Header="Source" Description="View DevDriveManager on GitHub"
                                                  IsClickEnabled="True" Click="Source_Click"
                                                  AutomationProperties.AutomationId="RepoLink"
                                                  AutomationProperties.Name="DevDriveManager source on GitHub">
                                <toolkit:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </toolkit:SettingsCard.ActionIcon>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>
                    <HyperlinkButton Content="Reset preferences" HorizontalAlignment="Left" Margin="0,16,0,0"
                                     AutomationProperties.AutomationId="ResetPreferencesButton"
                                     AutomationProperties.Name="Reset app preferences to defaults"
                                     Click="ResetPreferences_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
