<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        AI Dev Gallery's Store-like rail, hosted by the native NavigationView. The custom item
        presenter lives in Themes/StoreNavigationView.xaml; the platform owns selection, keyboard
        navigation, scrolling and the footer. MainWindow still owns the separate title bar.
    -->
    <NavigationView
        x:Name="ShellNavView"
        AutomationProperties.AutomationId="ShellNavView"
        AutomationProperties.Name="Rooms"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="ShellNavView_ItemInvoked"
        SelectionChanged="ShellNavView_SelectionChanged"
        Style="{StaticResource StoreNavigationViewStyle}">
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="SettingsNavItem"
                AutomationProperties.AutomationId="SettingsItem"
                AutomationProperties.Name="Settings"
                Content="Settings"
                Icon="Setting"
                Style="{StaticResource StoreNavigationViewItemStyle}"
                Tag="settings"
                ToolTipService.ToolTip="Settings" />
        </NavigationView.FooterMenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                UI-test seam indicator (present only when DDM_UITEST_SAFE_MUTATIONS=1). It lives in
                the shell rather than in a room: a warning that this app is only pretending to
                mutate the machine must not disappear when you navigate away from Overview.
            -->
            <Border
                Grid.Row="0"
                Padding="16,6"
                Background="{ThemeResource SmWarnTintBrush}"
                BorderBrush="{ThemeResource SmDividerBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.IsSafeMutationMode), Mode=OneWay}">
                <TextBlock
                    AutomationProperties.AutomationId="SafeMutationModeIndicator"
                    Style="{StaticResource SmStatusFactWarnStyle}"
                    Text="Safe-mutation test mode — nothing on this machine will actually change." />
            </Border>

            <!--
                Room title, or a breadcrumb back to the room while one of its sub-pages is open
                (Dev Drive › Create Dev Drive), the way Windows Settings titles nested pages.
                Rooms with more than one page show their tabs underneath.
            -->
            <StackPanel x:Name="PageHeader" Grid.Row="1" Padding="0,24,0,12">
                <TextBlock x:Name="PageTitle"
                           Margin="18,0"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.AutomationId="PageTitle"
                           AutomationProperties.HeadingLevel="Level1" />
                <BreadcrumbBar
                    x:Name="PageBreadcrumb"
                    Margin="18,0"
                    AutomationProperties.AutomationId="PageBreadcrumb"
                    AutomationProperties.HeadingLevel="Level1"
                    ItemClicked="PageBreadcrumb_ItemClicked"
                    Visibility="Collapsed">
                    <BreadcrumbBar.Resources>
                        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                        <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                        <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
                        <Thickness x:Key="BreadcrumbBarChevronPadding">11,0</Thickness>
                    </BreadcrumbBar.Resources>
                </BreadcrumbBar>
                <!-- Left margin lines the first tab's text up with the title (bar + item border + padding = 14). -->
                <SelectorBar
                    x:Name="RoomTabs"
                    Margin="4,8,18,0"
                    AutomationProperties.AutomationId="RoomTabs"
                    AutomationProperties.Name="Pages in this room"
                    SelectionChanged="RoomTabs_SelectionChanged"
                    Visibility="Collapsed" />
            </StackPanel>

            <Frame
                x:Name="ContentFrame"
                Grid.Row="2"
                AutomationProperties.AutomationId="ShellContentFrame"
                NavigationFailed="OnNavigationFailed" />
        </Grid>
    </NavigationView>
</Page>
