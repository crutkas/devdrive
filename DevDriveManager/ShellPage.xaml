<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        AutomationProperties.AutomationId="ShellNavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        IsTabStop="False"
        OpenPaneLength="248"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged">

        <!--
            The rail is built in code from RoomRegistry rather than declared here, so adding a room
            is one entry in one list instead of edits in three places that can silently disagree.
        -->

        <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ShellContentFrame" />
    </NavigationView>
</Page>
