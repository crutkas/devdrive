<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DevDriveManager.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DevDriveManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        AI Dev Gallery's Store-like rail, hosted by the native NavigationView. The custom item
        presenter lives in Themes/StoreNavigationView.xaml; the platform owns selection, keyboard
        navigation, scrolling and the footer. MainWindow still owns the separate title bar.
    -->
    <NavigationView
        x:Name="ShellNavView"
        AutomationProperties.AutomationId="ShellNavView"
        AutomationProperties.Name="Rooms"
        IsTitleBarAutoPaddingEnabled="False"
        SelectionChanged="ShellNavView_SelectionChanged"
        Style="{StaticResource StoreNavigationViewStyle}">
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="SettingsNavItem"
                AutomationProperties.AutomationId="SettingsItem"
                AutomationProperties.Name="Settings"
                Content="Settings"
                Icon="Setting"
                Style="{StaticResource StoreNavigationViewItemStyle}"
                Tag="settings"
                ToolTipService.ToolTip="Settings" />
        </NavigationView.FooterMenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                UI-test seam indicator (present only when DDM_UITEST_SAFE_MUTATIONS=1). It lives in
                the shell rather than in a room: a warning that this app is only pretending to
                mutate the machine must not disappear when you navigate away from Overview.
            -->
            <Border
                Grid.Row="0"
                Padding="16,6"
                Background="{ThemeResource SmWarnTintBrush}"
                BorderBrush="{ThemeResource SmDividerBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{x:Bind local:UiHelpers.BoolToVisibility(ViewModel.IsSafeMutationMode), Mode=OneWay}">
                <TextBlock
                    AutomationProperties.AutomationId="SafeMutationModeIndicator"
                    Style="{StaticResource SmStatusFactWarnStyle}"
                    Text="Safe-mutation test mode — nothing on this machine will actually change." />
            </Border>

            <!--
                48px is the header row every room shares: Space's picker and Scan, and the other
                rooms' header buttons, are that tall, so a room titled here centres its title on the
                same line. 12 above and below is the same gutter the rooms keep at their bottom edge.
            -->
            <Grid x:Name="PageHeader" Grid.Row="1" Margin="18,12,18,12" MinHeight="48">
                <TextBlock x:Name="PageTitle" VerticalAlignment="Center"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.AutomationId="PageTitle"
                           AutomationProperties.HeadingLevel="Level1" />
            </Grid>

            <Frame
                x:Name="ContentFrame"
                Grid.Row="2"
                AutomationProperties.AutomationId="ShellContentFrame"
                NavigationFailed="OnNavigationFailed" />
        </Grid>
    </NavigationView>
</Page>
