<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DevDriveManager.Controls.DevDriveDiskBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Raw"
    AutomationProperties.Name="Dev Drive size"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Segments are the app's category hues, not shades of one accent. Three tints of a
                      single colour (which is what SystemAccentColorLight1/2/3 are) differ only in
                      lightness, so the bar read as one muted block and the reader had to consult the
                      legend to find the boundary they came for.

                      The hues are the ones the rest of the app already assigns: the source volume is
                      painted with the system-volume colour and the new Dev Drive with the Dev Drive
                      colour, the same pairing the drive strip and every capacity bar use for C: and
                      G:. So the carve-out is coloured like the thing it is about to become rather
                      than like a lighter piece of the drive it came from.

                      Free is a desaturated slate, and reads as absence through saturation rather
                      than through texture. It used to be hatched with a LinearGradientBrush set to
                      SpreadMethod="Repeat", which is why this bar looked muted: a repeating brush
                      needs a tile surface, and its presence anywhere in this UserControl composited
                      everything EXCEPT the element carrying it at ~50% alpha. Measured, not guessed
                      — a #FF0000 probe rendered #8F1116, and solving the two channels gives
                      alpha 0.502 over the card background. Both bar segments and all three legend
                      swatches were affected, in two separate Grids, and moving the brush onto a
                      nested Rectangle only moved which element escaped. Every other bar in the app
                      uses solid fills and renders exactly, so Free joins them.

                      High Contrast swaps to SystemColor* so it auto-corrects, and keeps Used and Dev
                      on different system colours because a bar whose segments match is unreadable.  -->
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SmCategory0Brush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SmCategory2Brush" />
                    <SolidColorBrush x:Key="DiskBarFreeBrush" Color="#C9D2E2" />
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SmCategory0Brush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SmCategory2Brush" />
                    <SolidColorBrush x:Key="DiskBarFreeBrush" Color="#39415A" />
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DiskBarSeamBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <!--  Read-only visualization: used + protected | shrinkable free (hatched) | carved Dev Drive.
              Non-interactive on purpose — the page's Slider + NumberBox change the size.  -->
        <Border
            Height="32"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                    <ColumnDefinition x:Name="RemainingColumn" Width="0*" />
                    <ColumnDefinition x:Name="DevColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="0,0,1,0" />
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource DiskBarFreeBrush}"
                    BorderBrush="{ThemeResource DiskBarFreeBorderBrush}"
                    BorderThickness="{ThemeResource DiskBarFreeBorderThickness}" />
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource DiskBarDevBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="1,0,0,0" />
            </Grid>
        </Border>

        <!--
            Legend (swatches match the bar's segment fills). Laid out as a grid rather than one
            horizontal run, because this bar lives in a 336px column and three labels carrying byte
            counts do not fit on one line there — a horizontal StackPanel hands its children
            unconstrained width, so the third entry is silently cut by the card edge instead of
            wrapping.
        -->
        <Grid ColumnSpacing="14" RowSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UsedLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarFreeBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="1"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind RemainingLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarDevBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind DevDriveLabel, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
