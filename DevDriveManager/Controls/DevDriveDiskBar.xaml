<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DevDriveManager.Controls.DevDriveDiskBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Raw"
    AutomationProperties.Name="Dev Drive size"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Segments come from the user's accent palette (theming.md "accent color palette"), so the
                      whole bar is one cohesive family and tracks the user's chosen accent. Used = darkest
                      shade, Free = a mid shade with a diagonal hatch as a second cue, Dev Drive = the base
                      accent. Dark mirrors to the Light shades for contrast; High Contrast swaps to SystemColor*
                      so it auto-corrects. The hatch stops are ordered so a pad fallback degrades to solid Dark1
                      (never back to invisible white).  -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DiskBarUsedBrush" Color="{ThemeResource SystemAccentColorDark3}" />
                    <SolidColorBrush x:Key="DiskBarDevBrush" Color="{ThemeResource SystemAccentColor}" />
                    <LinearGradientBrush x:Key="DiskBarFreeBrush" EndPoint="6,6" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0">
                        <GradientStop Offset="0.0" Color="#40FFFFFF" />
                        <GradientStop Offset="0.2" Color="#40FFFFFF" />
                        <GradientStop Offset="0.2" Color="{ThemeResource SystemAccentColorDark1}" />
                        <GradientStop Offset="1.0" Color="{ThemeResource SystemAccentColorDark1}" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DiskBarUsedBrush" Color="{ThemeResource SystemAccentColorLight3}" />
                    <SolidColorBrush x:Key="DiskBarDevBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <LinearGradientBrush x:Key="DiskBarFreeBrush" EndPoint="6,6" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0">
                        <GradientStop Offset="0.0" Color="#59000000" />
                        <GradientStop Offset="0.2" Color="#59000000" />
                        <GradientStop Offset="0.2" Color="{ThemeResource SystemAccentColorLight1}" />
                        <GradientStop Offset="1.0" Color="{ThemeResource SystemAccentColorLight1}" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DiskBarSeamBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <!--  Read-only visualization: used + protected | shrinkable free (hatched) | carved Dev Drive.
              Non-interactive on purpose — the page's Slider + NumberBox change the size.  -->
        <Border
            Height="32"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                    <ColumnDefinition x:Name="RemainingColumn" Width="0*" />
                    <ColumnDefinition x:Name="DevColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="0,0,1,0" />
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource DiskBarFreeBrush}"
                    BorderBrush="{ThemeResource DiskBarFreeBorderBrush}"
                    BorderThickness="{ThemeResource DiskBarFreeBorderThickness}" />
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource DiskBarDevBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="1,0,0,0" />
            </Grid>
        </Border>

        <!--
            Legend (swatches match the bar's segment fills). Laid out as a grid rather than one
            horizontal run, because this bar lives in a 336px column and three labels carrying byte
            counts do not fit on one line there — a horizontal StackPanel hands its children
            unconstrained width, so the third entry is silently cut by the card edge instead of
            wrapping.
        -->
        <Grid ColumnSpacing="14" RowSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UsedLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarFreeBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="1"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind RemainingLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarDevBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind DevDriveLabel, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
