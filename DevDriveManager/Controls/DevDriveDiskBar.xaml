<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DevDriveManager.Controls.DevDriveDiskBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AccessibilityView="Raw"
    AutomationProperties.Name="Dev Drive size"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Segments are the app's category hues, not shades of one accent. Three tints of a
                      single colour (which is what SystemAccentColorLight1/2/3 are) differ only in
                      lightness, so the bar read as one muted block and the reader had to consult the
                      legend to find the boundary they came for.

                      The hues are the ones the rest of the app already assigns: the source volume is
                      painted with the system-volume colour and the new Dev Drive with the Dev Drive
                      colour, the same pairing the drive strip and every capacity bar use for C: and
                      G:. So the carve-out is coloured like the thing it is about to become rather
                      than like a lighter piece of the drive it came from.

                      Free is a desaturated slate, and reads as absence through saturation rather
                      than through texture. It used to be hatched with a LinearGradientBrush set to
                      SpreadMethod="Repeat", which is why this bar looked muted: a repeating brush
                      needs a tile surface, and its presence anywhere in this UserControl composited
                      everything EXCEPT the element carrying it at ~50% alpha. Measured, not guessed
                      — a #FF0000 probe rendered #8F1116, and solving the two channels gives
                      alpha 0.502 over the card background. Both bar segments and all three legend
                      swatches were affected, in two separate Grids, and moving the brush onto a
                      nested Rectangle only moved which element escaped. Every other bar in the app
                      uses solid fills and renders exactly, so Free joins them.

                      High Contrast swaps to SystemColor* so it auto-corrects, and keeps Used and Dev
                      on different system colours because a bar whose segments match is unreadable.  -->
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SmCategory0Brush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SmCategory2Brush" />
                    <StaticResource x:Key="DiskBarFreeBrush" ResourceKey="SmFreeTrackBrush" />
                    <StaticResource x:Key="DiskBarFreeLowBrush" ResourceKey="SmCategory3Brush" />
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SmCategory0Brush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SmCategory2Brush" />
                    <StaticResource x:Key="DiskBarFreeBrush" ResourceKey="SmFreeTrackBrush" />
                    <StaticResource x:Key="DiskBarFreeLowBrush" ResourceKey="SmCategory3Brush" />
                    <SolidColorBrush x:Key="DiskBarSeamBrush" Color="#59000000" />
                    <SolidColorBrush x:Key="DiskBarFreeBorderBrush" Color="Transparent" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="DiskBarUsedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarDevBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DiskBarFreeLowBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DiskBarSeamBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="DiskBarFreeBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="DiskBarFreeBorderThickness">2</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                The free channel is swapped between two states in code, and a Brush cannot be handed
                across that seam. Resources.TryGetValue returns the instance belonging to whichever
                theme dictionary is live at the moment it is called, and assigning it to Background
                sets a local value that outranks the style and never re-resolves — so the bar would
                keep its dark ink after a switch to Light. This is the fifth site in this app to hit
                that; the established answer is to hand over a Style instead.

                A Style object is theme-independent, so a static lookup of it is safe, and its
                ThemeResource setters re-resolve when the theme changes. Both styles live here, at
                dictionary root, deliberately outside ThemeDictionaries.
            -->
            <Style x:Key="DiskBarFreeSegmentStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DiskBarFreeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DiskBarFreeBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource DiskBarFreeBorderThickness}" />
            </Style>

            <Style
                x:Key="DiskBarFreeSegmentLowStyle"
                BasedOn="{StaticResource DiskBarFreeSegmentStyle}"
                TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DiskBarFreeLowBrush}" />
            </Style>

            <Style x:Key="DiskBarFreeSwatchStyle" TargetType="Border">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DiskBarSeamBrush}" />
                <Setter Property="Background" Value="{ThemeResource DiskBarFreeBrush}" />
            </Style>

            <Style
                x:Key="DiskBarFreeSwatchLowStyle"
                BasedOn="{StaticResource DiskBarFreeSwatchStyle}"
                TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DiskBarFreeLowBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="8">

        <!--  Read-only visualization: used + protected | free | carved Dev Drive.
              Non-interactive on purpose — the page's Slider + NumberBox change the size.

              The Dev Drive is drawn as its own rounded chunk with a gap before it, not as a third
              flush band. It is about to become a separate volume, and a bar that renders it flush
              with C: says the opposite — that it is one more region of the same disk.  -->
        <Border
            Height="32"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                    <ColumnDefinition x:Name="RemainingColumn" Width="0*" />
                    <ColumnDefinition x:Name="DevColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    BorderBrush="{ThemeResource DiskBarSeamBrush}"
                    BorderThickness="0,0,1,0" />
                <Border
                    x:Name="FreeSegment"
                    Grid.Column="1"
                    Style="{StaticResource DiskBarFreeSegmentStyle}" />
                <!--  Inset and fully rounded so it reads as a separate drive sitting in the space
                      carved for it. MinWidth keeps a tiny selection visible as a sliver rather than
                      collapsing to nothing at the low end of the slider.  -->
                <Border
                    x:Name="DevSegment"
                    Grid.Column="2"
                    MinWidth="6"
                    Margin="3"
                    Background="{ThemeResource DiskBarDevBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}" />
            </Grid>
        </Border>

        <!--
            Legend (swatches match the bar's segment fills). Laid out as a grid rather than one
            horizontal run, because this bar lives in a 336px column and three labels carrying byte
            counts do not fit on one line there — a horizontal StackPanel hands its children
            unconstrained width, so the third entry is silently cut by the card edge instead of
            wrapping.
        -->
        <Grid ColumnSpacing="14" RowSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarUsedBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind UsedLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">
                <Border x:Name="FreeSwatch" Style="{StaticResource DiskBarFreeSwatchStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind RemainingLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DiskBarDevBrush}"
                    CornerRadius="2" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind DevDriveLabel, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
