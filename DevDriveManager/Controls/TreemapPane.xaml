<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevDriveManager.Controls.TreemapPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    KeyDown="Pane_KeyDown">

    <UserControl.Resources>
        <!--
            Invisible, focusable stand-ins for the top-level rectangles. The map itself is drawn in
            Microsoft.UI.Composition, which has no automation or keyboard story of its own; these
            give Narrator and the keyboard something real to land on, with the system focus visual.
        -->
        <Style x:Key="TreemapAccessCellStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The scope's title strip, like an open folder's header in the map. Once the map has
            zoomed in, the parent folder sits in it as a rectangle that zooms back out. The strip
            keeps one fixed height at every scope: resizing the map mid-zoom would cut the zoom short.
        -->
        <Grid
            x:Name="ScopeStrip"
            Height="28"
            Padding="3,3,10,3"
            AutomationProperties.AutomationId="TreemapScopeStrip"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            ColumnSpacing="6"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="ParentButton"
                Height="22"
                MaxWidth="260"
                Padding="8,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TreemapNavigateUp"
                Click="ParentButton_Click"
                CornerRadius="3"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE74A;"
                        IsTextScaleFactorEnabled="False" />
                    <TextBlock
                        x:Name="ParentName"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsTextScaleFactorEnabled="False"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <FontIcon
                x:Name="ScopeGlyph"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextScaleFactorEnabled="False" />
            <TextBlock
                x:Name="ScopeName"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TreemapScopeName"
                FontSize="12"
                FontWeight="SemiBold"
                IsTextScaleFactorEnabled="False"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="ScopeSize"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TreemapScopeSize"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextScaleFactorEnabled="False" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid
                x:Name="CompositionHost"
                Background="Transparent"
                PointerCanceled="CompositionHost_PointerReleased"
                PointerCaptureLost="CompositionHost_PointerReleased"
                PointerExited="CompositionHost_PointerExited"
                PointerMoved="CompositionHost_PointerMoved"
                PointerPressed="CompositionHost_PointerPressed"
                PointerReleased="CompositionHost_PointerReleased"
                RightTapped="CompositionHost_RightTapped"
                SizeChanged="CompositionHost_SizeChanged"
                Tapped="CompositionHost_Tapped" />

            <Canvas
                x:Name="LabelCanvas"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False" />

            <Canvas
                x:Name="AccessCanvas"
                IsHitTestVisible="False"
                TabFocusNavigation="Once"
                XYFocusKeyboardNavigation="Enabled" />

            <Canvas
                x:Name="CardLayer"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False">
                <Border
                    x:Name="InfoCard"
                    MinWidth="200"
                    MaxWidth="320"
                    Padding="12,10"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </Border.OpacityTransition>
                    <!--
                        The card only fades; it stays in the tree while hidden, so its parts are kept out
                        of the automation tree. The focused stand-in's name already says the same.
                    -->
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="CardGlyph"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="16" />
                            <TextBlock
                                x:Name="CardTitle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                        <TextBlock
                            x:Name="CardSize"
                            Grid.Row="1"
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <ProgressBar
                            x:Name="CardShare"
                            Grid.Row="2"
                            Margin="0,2"
                            AutomationProperties.AccessibilityView="Raw"
                            Maximum="1"
                            Minimum="0" />
                        <TextBlock
                            x:Name="CardDetail"
                            Grid.Row="3"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="CardPath"
                            Grid.Row="4"
                            AutomationProperties.AccessibilityView="Raw"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Canvas>

            <TextBlock
                x:Name="TreemapEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TreemapEmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="No allocated bytes in this scope"
                Visibility="Collapsed" />

            <!--
                Colour probes. ThemeResource resolves against this element's own theme, which is the
                one the map must match; reading Application.Current.Resources would follow the app's
                theme instead. Composition cannot bind to resources, so the pane reads these back.
            -->
            <StackPanel
                x:Name="ThemeProbe"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Opacity="0">
                <Border x:Name="ProbeCategory0" Background="{ThemeResource SmCategory0Brush}" />
                <Border x:Name="ProbeCategory1" Background="{ThemeResource SmCategory1Brush}" />
                <Border x:Name="ProbeCategory2" Background="{ThemeResource SmCategory2Brush}" />
                <Border x:Name="ProbeCategory3" Background="{ThemeResource SmCategory3Brush}" />
                <Border x:Name="ProbeCategory4" Background="{ThemeResource SmCategory4Brush}" />
                <Border x:Name="ProbeCategory5" Background="{ThemeResource SmCategory5Brush}" />
                <Border x:Name="ProbeTextPrimary" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                <Border x:Name="ProbeTextSecondary" Background="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border x:Name="ProbeFocusInner" Background="{ThemeResource FocusStrokeColorInnerBrush}" />
                <Border x:Name="ProbeWindow" Background="{ThemeResource SystemColorWindowColorBrush}" />
                <Border x:Name="ProbeWindowText" Background="{ThemeResource SystemColorWindowTextColorBrush}" />
                <Border x:Name="ProbeHighlight" Background="{ThemeResource SystemColorHighlightColorBrush}" />
                <Border x:Name="ProbeGrayText" Background="{ThemeResource SystemColorGrayTextColorBrush}" />
                <Border x:Name="ProbeHotlight" Background="{ThemeResource SystemColorHotlightColorBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
