<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DevDriveManager.Controls.VolumeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevDriveManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="48"
    d:DesignWidth="296"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            A minimal button chrome. The stock Button template brings its own background and border
            states, which would fight the card's own selected/hover model, so the template is replaced
            outright rather than overridden setter by setter.

            Hover and selection are deliberately layered rather than merged into one visual state
            group: hover tints the border, selection adds an accent ring plus a tint, and a card can
            be both at once. Driving both from a single group would make hovering a selected card
            look like deselecting it.
        -->
        <Style x:Key="VolumeCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CardFill.BorderBrush" Value="{ThemeResource SmHoverStrokeBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CardFill.BorderBrush" Value="{ThemeResource SmAccentBrush}" />
                                            <Setter Target="CardFill.Background" Value="{ThemeResource SmHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardContent.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionRing.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border
                                x:Name="CardFill"
                                Background="{ThemeResource SmCardHeaderBrush}"
                                BorderBrush="{ThemeResource SmStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SmVolumeCornerRadius}" />

                            <Border
                                x:Name="SelectionRing"
                                Background="{ThemeResource SmSelectionBrush}"
                                BorderBrush="{ThemeResource SmAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SmVolumeCornerRadius}"
                                Opacity="0" />

                            <ContentPresenter
                                x:Name="CardContent"
                                Margin="11,5,11,6"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button
        x:Name="PartButton"
        MinWidth="296"
        Click="OnCardClick"
        Style="{StaticResource VolumeCardButtonStyle}">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="{StaticResource SmVolumeTileSize}"
                Height="{StaticResource SmVolumeTileSize}"
                Background="{ThemeResource SmCardBrush}"
                BorderBrush="{ThemeResource SmStrokeBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource SmTileCornerRadius}">
                <TextBlock
                    x:Name="PartLetter"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SmVolumeLetterTextStyle}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="3">
                <Grid ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PartName" Style="{StaticResource SmVolumeNameTextStyle}" />
                    <TextBlock
                        x:Name="PartCaption"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SmVolumeCaptionTextStyle}" />
                    <TextBlock
                        x:Name="PartFree"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SmVolumeFreeTextStyle}" />
                </Grid>

                <controls:CapacityBar x:Name="PartBar" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
