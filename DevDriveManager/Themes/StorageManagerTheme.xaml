<?xml version="1.0" encoding="utf-8" ?>
<!--
    Storage Manager design tokens.

    Lifted from files/storage-manager-rooms.html, which is the verified design spec (eight rooms,
    both themes, overflow-audited). Values are stated here once so a room never hardcodes a colour,
    and so the light theme is a real theme rather than an afterthought.

    The rgba() values in the spec are expressed as #AARRGGBB here: .786 -> C8, .544 -> 8B, .36 -> 5C,
    .10 -> 1A, .04 -> 0A, .80 -> CC, .58 -> 94, .40 -> 66, .08 -> 14, .035 -> 09.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SmCanvasBrush" Color="#10131A" />
            <SolidColorBrush x:Key="SmCardBrush" Color="#181C26" />
            <SolidColorBrush x:Key="SmCardHeaderBrush" Color="#1E2331" />
            <SolidColorBrush x:Key="SmStrokeBrush" Color="#2C3244" />
            <SolidColorBrush x:Key="SmDividerBrush" Color="#262C3B" />

            <!--
                Free space on a capacity bar. Deliberately NOT SmDividerBrush, which is what this
                used to be: a divider is designed to be barely there, and at #262C3B on the card
                header it measured 1.12:1, against the 3:1 WCAG asks for a graphical object. Free
                space was effectively invisible, which is a problem for the one quantity the whole
                app exists to increase.

                #657090 measures 3.19:1 on the card header and 3.47:1 on the card, while staying
                2.3:1 or more below the saturated bands so it still reads as an empty channel rather
                than another segment.
            -->
            <SolidColorBrush x:Key="SmFreeTrackBrush" Color="#657090" />

            <SolidColorBrush x:Key="SmTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SmMutedBrush" Color="#C8FFFFFF" />
            <SolidColorBrush x:Key="SmDimBrush" Color="#8BFFFFFF" />
            <SolidColorBrush x:Key="SmFaintBrush" Color="#5CFFFFFF" />

            <SolidColorBrush x:Key="SmAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="SmSelectionBrush" Color="#1A60CDFF" />
            <SolidColorBrush x:Key="SmHoverBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SmHoverStrokeBrush" Color="#4987AB" />

            <SolidColorBrush x:Key="SmCategory0Brush" Color="#7FB2FF" />
            <SolidColorBrush x:Key="SmCategory1Brush" Color="#B49BFA" />
            <SolidColorBrush x:Key="SmCategory2Brush" Color="#5FD4C4" />
            <SolidColorBrush x:Key="SmCategory3Brush" Color="#F2C46B" />
            <SolidColorBrush x:Key="SmCategory4Brush" Color="#F096BE" />
            <SolidColorBrush x:Key="SmCategory5Brush" Color="#A8B4CC" />

            <SolidColorBrush x:Key="SmGoodBrush" Color="#6CCB8B" />
            <SolidColorBrush x:Key="SmWarnBrush" Color="#F2C46B" />
            <SolidColorBrush x:Key="SmBadBrush" Color="#F0796F" />

            <!--
                Status-pill tints. The comp draws pills as an outline over a wash of their own colour
                (12% fill, 45% edge) rather than a solid block, so a column of them reads as annotation
                instead of as a column of buttons. Baked as literal alpha rather than computed because
                XAML has no colour-mix, and naming them keeps rooms out of the alpha business.
            -->
            <SolidColorBrush x:Key="SmGoodTintBrush" Color="#1F6CCB8B" />
            <SolidColorBrush x:Key="SmGoodEdgeBrush" Color="#736CCB8B" />
            <SolidColorBrush x:Key="SmWarnTintBrush" Color="#1FF2C46B" />
            <SolidColorBrush x:Key="SmWarnEdgeBrush" Color="#73F2C46B" />
            <SolidColorBrush x:Key="SmAccentTintBrush" Color="#1F60CDFF" />
            <SolidColorBrush x:Key="SmAccentEdgeBrush" Color="#7360CDFF" />
            <SolidColorBrush x:Key="SmMuteTintBrush" Color="Transparent" />

            <!--
                Treemap ink. The category brushes are light in the dark theme, so a treemap label
                has to be dark to stay legible — this is the one place the ink inverts relative to
                the rest of the theme, which is why it is a token rather than SmTextBrush.
            -->
            <SolidColorBrush x:Key="SmTreemapInkBrush" Color="#0B1018" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SmCanvasBrush" Color="#F1F3F8" />
            <SolidColorBrush x:Key="SmCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SmCardHeaderBrush" Color="#F7F9FC" />
            <SolidColorBrush x:Key="SmStrokeBrush" Color="#D9DEE9" />
            <SolidColorBrush x:Key="SmDividerBrush" Color="#E6EAF2" />

            <!--  3.38:1 on the white card and 3.04:1 on the canvas. Same reasoning as dark: free
                  space is a channel that has to be seen, not a divider.  -->
            <SolidColorBrush x:Key="SmFreeTrackBrush" Color="#818CA4" />

            <SolidColorBrush x:Key="SmTextBrush" Color="#141821" />
            <SolidColorBrush x:Key="SmMutedBrush" Color="#CC141821" />
            <SolidColorBrush x:Key="SmDimBrush" Color="#94141821" />
            <SolidColorBrush x:Key="SmFaintBrush" Color="#66141821" />

            <SolidColorBrush x:Key="SmAccentBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="SmSelectionBrush" Color="#140F6CBD" />
            <SolidColorBrush x:Key="SmHoverBrush" Color="#09141821" />
            <SolidColorBrush x:Key="SmHoverStrokeBrush" Color="#6A9FD1" />

            <SolidColorBrush x:Key="SmCategory0Brush" Color="#2F6FEB" />
            <SolidColorBrush x:Key="SmCategory1Brush" Color="#6D4AEF" />
            <SolidColorBrush x:Key="SmCategory2Brush" Color="#0F8F86" />
            <SolidColorBrush x:Key="SmCategory3Brush" Color="#B2670A" />
            <SolidColorBrush x:Key="SmCategory4Brush" Color="#BC2E70" />
            <SolidColorBrush x:Key="SmCategory5Brush" Color="#54617A" />

            <SolidColorBrush x:Key="SmGoodBrush" Color="#0F7B3F" />
            <SolidColorBrush x:Key="SmWarnBrush" Color="#8A5A00" />
            <SolidColorBrush x:Key="SmBadBrush" Color="#B3261E" />

            <!--  Same recipe as dark, over the light palette's deeper semantic colours.  -->
            <SolidColorBrush x:Key="SmGoodTintBrush" Color="#1F0F7B3F" />
            <SolidColorBrush x:Key="SmGoodEdgeBrush" Color="#730F7B3F" />
            <SolidColorBrush x:Key="SmWarnTintBrush" Color="#1F8A5A00" />
            <SolidColorBrush x:Key="SmWarnEdgeBrush" Color="#738A5A00" />
            <SolidColorBrush x:Key="SmAccentTintBrush" Color="#1F0F6CBD" />
            <SolidColorBrush x:Key="SmAccentEdgeBrush" Color="#730F6CBD" />
            <SolidColorBrush x:Key="SmMuteTintBrush" Color="Transparent" />

            <!-- Light theme category brushes are saturated, so the label inverts the other way. -->
            <SolidColorBrush x:Key="SmTreemapInkBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!--
            High contrast defers entirely to the user's chosen system colours. The spec's palette is
            a designed one; under high contrast the only correct palette is the one the user picked,
            so every token maps to a system brush rather than to a dimmed variant of our own.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SmCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SmCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SmCardHeaderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SmStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <!--  GrayText, not WindowText: the free channel has to be visible against the window
                  while staying distinguishable from the bands beside it, which are WindowText and
                  Highlight. A free channel painted WindowText would merge with the used band.  -->
            <SolidColorBrush x:Key="SmFreeTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="SmTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmDimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SmFaintBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="SmAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmHoverStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="SmCategory0Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmCategory1Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmCategory2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmCategory3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmCategory4Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmCategory5Brush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="SmGoodBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmBadBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <!--
                No tint under high contrast: a wash of colour is exactly what the mode exists to remove.
                The pill keeps its border and its text colour, which is what carries the meaning anyway.
            -->
            <SolidColorBrush x:Key="SmGoodTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SmGoodEdgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmWarnTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SmWarnEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SmAccentTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SmAccentEdgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SmMuteTintBrush" Color="Transparent" />

            <SolidColorBrush x:Key="SmTreemapInkBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
        Geometry. Stated as resources because the density is the design: the spec's rail is a 64px
        column holding 56px buttons, and the status bar is 38px. Getting these wrong by a few pixels
        is what made the first attempt at this room read as a different product.
    -->
    <x:Double x:Key="SmRailWidth">64</x:Double>
    <x:Double x:Key="SmRailButtonWidth">56</x:Double>
    <x:Double x:Key="SmStatusBarHeight">38</x:Double>
    <x:Double x:Key="SmCapacityBarHeight">5</x:Double>
    <x:Double x:Key="SmVolumeTileSize">29</x:Double>

    <CornerRadius x:Key="SmCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SmVolumeCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="SmTileCornerRadius">6</CornerRadius>

    <!--
        A pill's radius is half its height, stated literally — NOT a huge number.

        CSS `border-radius: 999px` scales every radius by one factor and yields a stadium. WinUI clamps
        each corner per axis instead (half the width horizontally, half the height vertically), so 999 on
        a wide short border gives an ellipse, which is what this used to render. 10 is half of the 20px
        pill in SmPillStyle; change the two together.
    -->
    <CornerRadius x:Key="SmPillCornerRadius">10</CornerRadius>

    <!--
        The type ramp.

        This deliberately does not reuse the built-in Fluent text styles. The design is denser than
        the default ramp (13px volume names, 10.5px captions, 9.5px metric labels), and that density
        is the point rather than an accident — the first attempt at this shell used the stock ramp
        and read as a different product. Naming the sizes here means a room still never writes a raw
        FontSize, and re-tuning the ramp stays one edit.

        CharacterSpacing is in 1/1000 em, so the spec's .09em and .1em are 90 and 100.
    -->
    <Style x:Key="SmVolumeNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmVolumeLetterTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
    </Style>

    <!--
        The tier number. 15px semibold tabular so the four cards' figures line up on the decimal —
        four sizes that do not align read as four unrelated facts.
    -->
    <Style x:Key="SmTierValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
    </Style>

    <Style x:Key="SmVolumeCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmVolumeFreeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource SmMutedBrush}" />
    </Style>

    <Style x:Key="SmMetricLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <Style x:Key="SmMetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
    </Style>

    <Style x:Key="SmStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <!--
        Status-bar facts, one style per emphasis.

        These exist as Styles rather than as a value converter returning a Brush because a converter
        resolves the brush once, at the moment the row is realised, and hands back that theme
        dictionary's instance. Nothing re-runs it when the theme flips, so the bar kept its dark ink
        on the light surface and the facts went invisible. A Style is theme-independent; its
        {ThemeResource} setters re-resolve on the change.

        Emphasis is carried by weight as well as hue, so it survives high contrast and readers who
        cannot separate the two colours.
    -->
    <Style
        x:Key="SmStatusFactStyle"
        BasedOn="{StaticResource SmStatusTextStyle}"
        TargetType="TextBlock" />

    <Style
        x:Key="SmStatusFactGoodStyle"
        BasedOn="{StaticResource SmStatusTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmGoodBrush}" />
    </Style>

    <Style
        x:Key="SmStatusFactWarnStyle"
        BasedOn="{StaticResource SmStatusTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmWarnBrush}" />
    </Style>

    <Style
        x:Key="SmStatusFactBadStyle"
        BasedOn="{StaticResource SmStatusTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmBadBrush}" />
    </Style>

    <!--  The rail's section divider. A Style so the rule re-resolves when the theme changes.  -->
    <Style x:Key="SmRailDividerStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource SmDividerBrush}" />
    </Style>

    <Style x:Key="SmRailSectionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmFaintBrush}" />
    </Style>

    <!--
        Room chrome: card heads, tables, trees, inspectors. Spec values, not invented ones —
        .cardhead h3 is 13/600, .cardhead .sub 11.5 dim, thead th 10.5/.08em/uppercase/dim,
        tbody td 13.5, .tnode 13 with a 12px dim value, .kv 11.5 dim, .chip 11.5 dim.
    -->

    <!--
        The three container shapes every room is built from. These started life in SpacePage and
        moved here the moment a second room needed them — a room that redefines its own card is a
        room that will drift away from the others.
    -->

    <!--  A card. Spec: card fill, 1px stroke, 8px radius.  -->
    <Style x:Key="SmCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SmCardCornerRadius}" />
    </Style>

    <!--  A card head. Spec: 38px min-height, 0 14px padding, cardhead fill, bottom divider.  -->
    <Style x:Key="SmCardHeadStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmCardHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <!--  A chip. Spec: 11.5px dim text, 4px 9px padding, 11px radius, 1px stroke.  -->
    <Style x:Key="SmChipStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,3,9,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A status pill. Spec: 11px semibold text, 2px 9px padding, 1px border, stadium ends.

        MinHeight is fixed so a column of pills is one shape repeated rather than each one sized by its
        own text — the read is "same kind of thing, different value", and ragged heights break that.
    -->
    <Style x:Key="SmPillStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SmPillCornerRadius}" />
        <Setter Property="Padding" Value="9,0,9,1" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        One style per pill state, rather than a helper that looks the brushes up in C#.

        A helper returns whichever SolidColorBrush instance was live when the binding ran, and an
        x:Bind function binding has nothing to re-evaluate on when the theme changes — so an imperative
        brush freezes at the theme the row was first built under and turns near-white text loose on a
        white page. Setters resolved with ThemeResource re-evaluate on the theme change itself. The
        style objects live outside the theme dictionaries, so looking *them* up statically is safe.
    -->
    <Style
        x:Key="SmPillGoodStyle"
        BasedOn="{StaticResource SmPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmGoodTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmGoodEdgeBrush}" />
    </Style>

    <Style
        x:Key="SmPillWarnStyle"
        BasedOn="{StaticResource SmPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmWarnTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmWarnEdgeBrush}" />
    </Style>

    <Style
        x:Key="SmPillMuteStyle"
        BasedOn="{StaticResource SmPillStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmMuteTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
    </Style>

    <Style
        x:Key="SmPillGoodTextStyle"
        BasedOn="{StaticResource SmPillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmGoodBrush}" />
    </Style>

    <Style
        x:Key="SmPillWarnTextStyle"
        BasedOn="{StaticResource SmPillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmWarnBrush}" />
    </Style>

    <Style
        x:Key="SmPillMuteTextStyle"
        BasedOn="{StaticResource SmPillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <!--
        Monospaced data cells — paths and environment-variable names. Both are things the user will
        compare character by character or retype, which is exactly what a proportional face makes hard.
    -->
    <Style x:Key="SmMonoCellTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  The same cell, quietened, for a value that is an absence rather than a name.  -->
    <Style
        x:Key="SmMonoFaintCellTextStyle"
        BasedOn="{StaticResource SmMonoCellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmFaintBrush}" />
    </Style>

    <!--
        A card-head tab. A Button rather than a bare Border so it is focusable, keyboard-operable and
        exposes InvokePattern; the chrome is stripped back to text and the room draws the underline.
    -->
    <Style x:Key="SmTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9,12,10" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="SmTabTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The selected tab is heavier AND brighter AND underlined — three cues, because weight alone is
        nearly invisible at 13px and colour alone fails for anyone who cannot separate the two greys.
    -->
    <Style
        x:Key="SmTabSelectedTextStyle"
        BasedOn="{StaticResource SmTabTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
    </Style>

    <Style
        x:Key="SmTabNormalTextStyle"
        BasedOn="{StaticResource SmTabTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <!--  Ecosystem swatches. One style per ramp colour, for the same theme reason as the pills.  -->
    <Style x:Key="SmSwatchStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="SmSwatch0Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory0Brush}" />
    </Style>
    <Style
        x:Key="SmSwatch1Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory1Brush}" />
    </Style>
    <Style
        x:Key="SmSwatch2Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory2Brush}" />
    </Style>
    <Style
        x:Key="SmSwatch3Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory3Brush}" />
    </Style>
    <Style
        x:Key="SmSwatch4Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory4Brush}" />
    </Style>
    <Style
        x:Key="SmSwatch5Style"
        BasedOn="{StaticResource SmSwatchStyle}"
        TargetType="Rectangle">
        <Setter Property="Fill" Value="{ThemeResource SmCategory5Brush}" />
    </Style>

    <Style x:Key="SmTabCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource SmFaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A card-head button. The default button is 32px tall with 11px text, which is taller than the
        card head it sits in — the head is 142 in the spec and a default button forces it past that.
        Based on DefaultButtonStyle so focus visuals, hover, and high contrast are inherited rather
        than reimplemented; only the metrics change.
    -->
    <Style
        x:Key="SmCompactButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        A tier card. Four of these sit side by side under the after-picture, each holding one risk
        tier's bytes and item count. Bordered rather than filled so they read as a measured breakdown
        of the bar above them, not as four more buttons.
    -->
    <Style x:Key="SmTierCardStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="10,7,10,8" />
    </Style>

    <!--
        A node in the Drives room's I/O path stack: one filter driver, or one endpoint of the write.

        Three variants rather than one styled by a brush binding, for the same reason the pills are
        three styles — a function binding that returns a Brush hands back the live theme dictionary's
        instance and never re-resolves, so it freezes at whatever theme was current when the node was
        built. A Style is theme-independent and its ThemeResource setters re-resolve on the switch.

        Attached and detached differ in fill AND in text weight, not in colour alone: on a stack where
        most nodes are one state and a few are the other, colour alone is the thing a colour-blind or
        high-contrast user loses.
    -->
    <Style x:Key="SmStackNodeStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6,10,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource SmMuteTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
    </Style>

    <Style
        x:Key="SmStackNodeOnStyle"
        BasedOn="{StaticResource SmStackNodeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmGoodTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmGoodEdgeBrush}" />
    </Style>

    <Style
        x:Key="SmStackNodeOffStyle"
        BasedOn="{StaticResource SmStackNodeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmDividerBrush}" />
    </Style>

    <!--  The two ends of the path — where the write comes from and where it lands.  -->
    <Style
        x:Key="SmStackNodeEndStyle"
        BasedOn="{StaticResource SmStackNodeStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmAccentEdgeBrush}" />
    </Style>

    <Style x:Key="SmStackNodeTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  A filter that does not run here: quietened, and not bold, so the stack reads at a glance.  -->
    <Style
        x:Key="SmStackNodeTitleFaintTextStyle"
        BasedOn="{StaticResource SmStackNodeTitleTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SmMutedBrush}" />
    </Style>

    <Style x:Key="SmStackNodeCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  The connector between two nodes. A rule, not a glyph, so it scales with the row spacing.  -->
    <Style x:Key="SmStackArrowStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource SmStrokeBrush}" />
    </Style>

    <Style x:Key="SmCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmCardSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmColumnHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmCellTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        Numeric cells are tabular so columns of sizes line up on the decimal. Without this the
        digit widths drift and a column of byte counts reads as ragged noise.
    -->
    <Style
        x:Key="SmNumericCellTextStyle"
        BasedOn="{StaticResource SmCellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="SmTreeNodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SmTreeValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <Style x:Key="SmKeyValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SmSectionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <!--
        The treemap rectangle. Content alignment is Stretch so the label sits top-left rather than
        centred: a centred label in a tall thin rectangle collides with its neighbours' labels.
    -->
    <Style x:Key="SmTreemapCellStyle" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="9,7,9,7" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmCardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Content="{TemplateBinding Content}" />
                        <Grid x:Name="HoverVeil" Opacity="0">
                            <Rectangle Fill="{ThemeResource SmTextBrush}" Opacity="0.14" RadiusX="4" RadiusY="4" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.09" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverVeil"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        The rail button. Spec: 56px wide inside a 64px column, 19px icon over a 9.5px label, dim
        until hovered, and a 3px accent bar plus a selection tint when it is the current room.
        Selection is carried by three things at once — bar, tint, and ink weight — so it survives
        both high contrast and a user who cannot distinguish the accent hue.
    -->
    <Style x:Key="SmRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SmRailButtonWidth}" />
        <Setter Property="Padding" Value="0,6,0,5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  The accent bar sits in the 8px gutter, outside the button's own fill.  -->
                        <Rectangle
                            x:Name="AccentBar"
                            Grid.Column="0"
                            Width="3"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource SmAccentBrush}"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Visibility="Collapsed" />

                        <Border
                            x:Name="Fill"
                            Grid.Column="1"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter
                                x:Name="ContentHost"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource SmHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource SmSelectionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--
                                Selection is its own state group so hovering the current room does
                                not read as leaving it.

                                The selected room's ink is set here, not in code. Assigning
                                Button.Foreground imperatively writes a local value that outranks the
                                style AND never re-resolves, so the rail kept its dark ink when the
                                theme flipped to light and every label went invisible. A VisualState
                                setter with a {ThemeResource} value re-resolves on the theme change,
                                and clears cleanly when the state is left.
                            -->
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="AccentBar.Visibility" Value="Visible" />
                                        <Setter Target="Fill.Background" Value="{ThemeResource SmSelectionBrush}" />
                                        <Setter Target="ContentHost.Foreground" Value="{ThemeResource SmTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Rail section header. Spec: 8px, .12em tracking, uppercase, faint.  -->
    <Style x:Key="SmRailSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="8" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmFaintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
        Risk chips (Reclaim). Same reason as the status facts: a Style, not a converted Brush, so the
        chip re-inks on a theme switch. Border and text are separate styles because the chip's colour
        has to reach both the outline and the label, and a Border does not pass Foreground down.

        These sit at the end of the dictionary because BasedOn uses {StaticResource}, which only sees
        keys declared above it — SmChipStyle and SmCardSubTextStyle are both defined further up.
    -->
    <Style
        x:Key="SmRiskChipStyle"
        BasedOn="{StaticResource SmChipStyle}"
        TargetType="Border" />

    <Style
        x:Key="SmRiskChipGoodStyle"
        BasedOn="{StaticResource SmChipStyle}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SmGoodBrush}" />
    </Style>

    <Style
        x:Key="SmRiskChipWarnStyle"
        BasedOn="{StaticResource SmChipStyle}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SmWarnBrush}" />
    </Style>

    <Style
        x:Key="SmRiskChipBadStyle"
        BasedOn="{StaticResource SmChipStyle}"
        TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SmBadBrush}" />
    </Style>

    <Style
        x:Key="SmRiskChipTextStyle"
        BasedOn="{StaticResource SmCardSubTextStyle}"
        TargetType="TextBlock" />

    <Style
        x:Key="SmRiskChipTextGoodStyle"
        BasedOn="{StaticResource SmCardSubTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmGoodBrush}" />
    </Style>

    <Style
        x:Key="SmRiskChipTextWarnStyle"
        BasedOn="{StaticResource SmCardSubTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmWarnBrush}" />
    </Style>

    <Style
        x:Key="SmRiskChipTextBadStyle"
        BasedOn="{StaticResource SmCardSubTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmBadBrush}" />
    </Style>

    <!--
        Overview signal dots. A round tinted disc with a glyph in it, one per signal kind.

        The glyph matters as much as the colour: in high contrast every tint collapses to the same
        ink, and a table whose only difference between "you gain 218 GB" and "this volume is about to
        fail" is a hue is a table that says nothing to a third of its readers.
    -->
    <Style x:Key="SmSignalDotStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource SmMuteTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
    </Style>

    <Style
        x:Key="SmSignalDotGainStyle"
        BasedOn="{StaticResource SmSignalDotStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmGoodTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmGoodEdgeBrush}" />
    </Style>

    <Style
        x:Key="SmSignalDotWarnStyle"
        BasedOn="{StaticResource SmSignalDotStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmWarnTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmWarnEdgeBrush}" />
    </Style>

    <Style
        x:Key="SmSignalDotBadStyle"
        BasedOn="{StaticResource SmSignalDotStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmBadBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmBadBrush}" />
    </Style>

    <Style
        x:Key="SmSignalDotInfoStyle"
        BasedOn="{StaticResource SmSignalDotStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SmAccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmAccentEdgeBrush}" />
    </Style>

    <!--  The glyph inside a signal dot. Sized to the disc, not to the body text.  -->
    <Style x:Key="SmSignalGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
    </Style>

    <Style
        x:Key="SmSignalGlyphGainStyle"
        BasedOn="{StaticResource SmSignalGlyphStyle}"
        TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SmGoodBrush}" />
    </Style>

    <Style
        x:Key="SmSignalGlyphWarnStyle"
        BasedOn="{StaticResource SmSignalGlyphStyle}"
        TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SmWarnBrush}" />
    </Style>

    <Style
        x:Key="SmSignalGlyphBadStyle"
        BasedOn="{StaticResource SmSignalGlyphStyle}"
        TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SmCanvasBrush}" />
    </Style>

    <Style
        x:Key="SmSignalGlyphInfoStyle"
        BasedOn="{StaticResource SmSignalGlyphStyle}"
        TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SmAccentBrush}" />
    </Style>

    <!--
        The impact figure. A gain is the one number in the room worth colouring, because it is the
        only one that answers "what do I get" — everything else is a measurement.
    -->
    <Style
        x:Key="SmImpactTextStyle"
        BasedOn="{StaticResource SmNumericCellTextStyle}"
        TargetType="TextBlock" />

    <Style
        x:Key="SmImpactGainTextStyle"
        BasedOn="{StaticResource SmNumericCellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmGoodBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="SmImpactWarnTextStyle"
        BasedOn="{StaticResource SmNumericCellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmWarnBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="SmImpactBadTextStyle"
        BasedOn="{StaticResource SmNumericCellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmBadBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        The free-space chart. Measured and projected are two Polylines rather than one dashed line,
        because the join between them has to be exact — a single line with a StrokeDashArray would
        fade at whatever pixel the dash pattern happened to land on rather than at the last real
        reading.
    -->
    <Style x:Key="SmSparkMeasuredStyle" TargetType="Polyline">
        <Setter Property="Stroke" Value="{ThemeResource SmCategory0Brush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <Style x:Key="SmSparkProjectedStyle" TargetType="Polyline">
        <Setter Property="Stroke" Value="{ThemeResource SmCategory5Brush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="3,3" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style x:Key="SmSparkFillStyle" TargetType="Polygon">
        <Setter Property="Fill" Value="{ThemeResource SmAccentTintBrush}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--  Legend swatch for the chart. Square, not a line: it has to read at 8px.  -->
    <Style x:Key="SmLegendSwatchStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="RadiusX" Value="2" />
        <Setter Property="RadiusY" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--
        A chip the user can press: the same outline as SmChipStyle, but a real Button so it is
        focusable, reachable by Tab and announced as invokable. A Border with a tap handler would
        look identical and be unusable without a mouse.
    -->
    <Style x:Key="SmChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="9,3,9,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SmHoverBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource SmHoverStrokeBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        ================= Settings rows =================

        A setting row is a label, a one-line explanation, and one control, separated by a hairline.
        Spec: 8px 14px padding, 13.5px label at weight 500, 11.5px dim sub, both at 1.4 line-height.

        The divider is on the row rather than between rows so a card can hold any number of them
        without the caller having to know which one is last — the final hairline lands on the card's
        own edge and reads as the card border.
    -->
    <Style x:Key="SmSetRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderBrush" Value="{ThemeResource SmDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="SmSetLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SmSetSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The setting-row combo. Sized to the comp's .combo (12.5px, 4px 10px, 5px radius) rather than
        the platform default, which is 32px tall and turns eleven rows into two screens.
    -->
    <Style
        x:Key="SmSetComboStyle"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,3,6,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The setting-row switch. WinUI's ToggleSwitch reserves ~100px for on/off labels it is not
        showing here; with the label to its left that reservation is dead space, so the width is
        pinned to the knob.
    -->
    <Style
        x:Key="SmSetToggleStyle"
        BasedOn="{StaticResource DefaultToggleSwitchStyle}"
        TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--
        The "way back" cell in the Settings write-surface table. Two styles rather than a brush from
        a function binding: a Style is theme-independent, and its ThemeResource setters re-resolve
        when the theme changes. The words carry the meaning on their own; the ink only reinforces it.
    -->
    <Style x:Key="SmReturnPathTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmReturnNoneTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource SmDimBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The track a benchmark bar is drawn in. Fixed width on purpose: PerfSuiteRowViewModel computes
        SystemBarWidth and DevBarWidth in pixels against a maxBarWidth it was constructed with, not as
        a fraction, so the track has to be the width that math assumed or every bar lies about its
        ratio. 300 is that number, and it is asserted by PerfSuiteViewModelTests.
    -->
    <Style x:Key="SmBenchBarTrackStyle" TargetType="Border">
        <Setter Property="Height" Value="11" />
        <Setter Property="Background" Value="{ThemeResource SmMuteTintBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Why a delete left a row behind. A Style rather than a Foreground brush set at the call
        site: a resolved Brush freezes at whichever theme was live when the row was built, and
        these rows outlive a theme switch. The setter re-resolves; a Brush instance cannot.

        Declared here, at the end, because BasedOn with StaticResource only sees keys defined
        ABOVE it in the same dictionary, and SmCardSubTextStyle is at line 639.
    -->
    <Style
        x:Key="SmCardSubTextBadStyle"
        BasedOn="{StaticResource SmCardSubTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SmBadBrush}" />
    </Style>

    <Style
        x:Key="SmKeyValueBadTextStyle"
        BasedOn="{StaticResource SmKeyValueTextStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SmBadBrush}" />
    </Style>

</ResourceDictionary>
