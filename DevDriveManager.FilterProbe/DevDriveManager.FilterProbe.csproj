<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DevDriveManager.FilterProbe: a tiny, self-contained console helper that the main app launches
    UAC-elevated (Verb="runas") so it can do one elevated thing per short UAC prompt WITHOUT restarting
    the whole app as administrator (the "Iso app" pattern).

    It started life strictly READ-ONLY (`fsutil devdrv query <X:>` => JSON), and that `query` verb still
    performs NO mutation. It also hosts the resize and VHDX brokers: the `resize` whatif mode is
    READ-ONLY (feasibility only), while the `resize` execute mode is the single DESTRUCTIVE path
    (shrink => carve => Format-Volume DevDrive). The destructive path is reached only via an explicit,
    authorized execute request after a successful preview, an explicit second confirmation, and UAC
    elevation; before it runs, ResizeGuard re-validates the plan against a fresh read-only disk snapshot.
    The `vhd` verb creates or reverts only an explicitly authorized VHDX path. See Program.cs for the
    full safety model.

    Self-contained Windows net10.0 win-x64/win-arm64. It ships INSIDE the MSIX next to DevDriveManager.exe (see
    the copy target in DevDriveManager.csproj), so when launched it resolves the .NET runtime that the
    main app carries in that same directory.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DevDriveManager.FilterProbe</RootNamespace>
    <AssemblyName>DevDriveManager.FilterProbe</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <!-- RID follows the build Platform so the apphost arch matches the main app (x64 by default). -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!--
      MUST be self-contained: shipped INSIDE the main app's self-contained MSIX, the helper's apphost
      otherwise loads the package's bundled (self-contained) hostfxr.dll, which then can't find a shared
      framework and fails to launch. A self-contained apphost instead resolves the runtime from its own
      directory — which is the main app's install dir, where the .NET runtime already lives. Only the
      helper's OWN 4 files are copied into the package (see DevDriveManager.csproj), NOT a duplicate
      runtime, so the package stays lean.
    -->
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No UI, no satellite assemblies, no extra junk in the package dir. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The helper uses the exact tested Core guards, VHD API, scripts, and wire contracts. DevDriveCore.dll
       already ships beside the main app, so this adds no duplicate package payload. -->
  <ItemGroup>
    <ProjectReference Include="..\DevDriveCore\DevDriveCore.csproj" />
  </ItemGroup>

</Project>
