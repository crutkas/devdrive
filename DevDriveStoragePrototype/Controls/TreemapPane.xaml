<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevDriveStoragePrototype.Controls.TreemapPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Canvas
            x:Name="TreemapCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            SizeChanged="TreemapCanvas_SizeChanged" />

        <StackPanel
            x:Name="TreemapEmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                AutomationProperties.AutomationId="TreemapEmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No allocated bytes in this scope" />
        </StackPanel>
    </Grid>
</UserControl>
