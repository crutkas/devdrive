<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DevDriveStoragePrototype.Controls.InspectorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevDriveStoragePrototype.Controls">

    <Grid>
        <ScrollViewer
            x:Name="DetailScroller"
            Padding="16,12,16,14"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind local:InspectorPane.BoolToVisibility(HasSelection), Mode=OneWay}">
            <StackPanel Spacing="10">

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorNameText"
                        Text="{x:Bind SelectedName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorPathText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind SelectedPath, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="ALLOCATED" />
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.AutomationId="InspectorSizeText"
                                Text="{x:Bind SelectedSize, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="% OF SCOPE" />
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.AutomationId="InspectorShareText"
                                Text="{x:Bind SelectedShare, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Style="{StaticResource MetricCardStyle}"
                    Visibility="{x:Bind local:InspectorPane.BoolToVisibility(HasLogicalDifference), Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="LOGICAL (APPARENT) SIZE" />
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            AutomationProperties.AutomationId="InspectorLogicalText"
                            Text="{x:Bind SelectedLogical, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind LogicalExplanation, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorIdentityText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind PhysicalIdentity, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorModifiedText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ModifiedSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource WorkbenchDividerBrush}" />

                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorProviderText"
                        Text="{x:Bind ProviderName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        AutomationProperties.AutomationId="InspectorProviderIdentityText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ProviderIdentity, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Border
                        Style="{StaticResource MetricCardStyle}"
                        Visibility="{x:Bind local:InspectorPane.BoolToVisibility(HasProvider), Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                AutomationProperties.AutomationId="InspectorProviderStatusText"
                                Text="{x:Bind ProviderStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ProviderEvidence, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Advisory only. It never changes physical identity or byte totals."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:InspectorPane.BoolToVisibility(HasNoSelection), Mode=OneWay}">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE946;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                AutomationProperties.AutomationId="InspectorEmptyText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Select an item to inspect it"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
