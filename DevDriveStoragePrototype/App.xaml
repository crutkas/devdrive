<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DevDriveStoragePrototype.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#FF10131A" />
                    <SolidColorBrush x:Key="WorkbenchCardBrush" Color="#FF181C26" />
                    <SolidColorBrush x:Key="WorkbenchCardHeaderBrush" Color="#FF1E2331" />
                    <SolidColorBrush x:Key="WorkbenchCardStrokeBrush" Color="#FF2C3244" />
                    <SolidColorBrush x:Key="WorkbenchDividerBrush" Color="#FF262C3B" />
                    <SolidColorBrush x:Key="TreemapLabelBrush" Color="#FF0B1018" />
                    <SolidColorBrush x:Key="TreemapOverlayBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TreemapEmptyBrush" Color="#FF262C3B" />
                    <SolidColorBrush x:Key="TreemapBrush0" Color="#FF7FB2FF" />
                    <SolidColorBrush x:Key="TreemapBrush1" Color="#FFB49BFA" />
                    <SolidColorBrush x:Key="TreemapBrush2" Color="#FF5FD4C4" />
                    <SolidColorBrush x:Key="TreemapBrush3" Color="#FFF2C46B" />
                    <SolidColorBrush x:Key="TreemapBrush4" Color="#FFF096BE" />
                    <SolidColorBrush x:Key="TreemapBrush5" Color="#FFA8B4CC" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#FFF1F3F8" />
                    <SolidColorBrush x:Key="WorkbenchCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchCardHeaderBrush" Color="#FFF7F9FC" />
                    <SolidColorBrush x:Key="WorkbenchCardStrokeBrush" Color="#FFD9DEE9" />
                    <SolidColorBrush x:Key="WorkbenchDividerBrush" Color="#FFE6EAF2" />
                    <SolidColorBrush x:Key="TreemapLabelBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TreemapOverlayBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TreemapEmptyBrush" Color="#FFE6EAF2" />
                    <SolidColorBrush x:Key="TreemapBrush0" Color="#FF2F6FEB" />
                    <SolidColorBrush x:Key="TreemapBrush1" Color="#FF6D4AEF" />
                    <SolidColorBrush x:Key="TreemapBrush2" Color="#FF0F8F86" />
                    <SolidColorBrush x:Key="TreemapBrush3" Color="#FFB2670A" />
                    <SolidColorBrush x:Key="TreemapBrush4" Color="#FFBC2E70" />
                    <SolidColorBrush x:Key="TreemapBrush5" Color="#FF54617A" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkbenchCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkbenchCardHeaderBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkbenchCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WorkbenchDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TreemapLabelBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="TreemapOverlayBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TreemapEmptyBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TreemapBrush0" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TreemapBrush1" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TreemapBrush2" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TreemapBrush3" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TreemapBrush4" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="TreemapBrush5" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="WorkbenchCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkbenchCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>

            <Style x:Key="CardHeaderBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkbenchCardHeaderBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchDividerBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,10,16,10" />
            </Style>

            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4,8,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkbenchCardHeaderBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="12,8,12,10" />
            </Style>

            <!-- A minimal template so the palette fill survives hover and press; the
                 stock Button template would swap the background to a neutral brush. -->
            <Style x:Key="TreemapCellStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,8,10,8" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkbenchCardBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <Grid x:Name="HoverOverlay" Background="{ThemeResource TreemapOverlayBrush}" Opacity="0" />
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverOverlay.Opacity" Value="0.3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
