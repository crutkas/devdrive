<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DevDriveCore: UI-agnostic Dev Drive logic library.

    DESIGN CONTRACT (Milestone 1): This assembly must contain ALL Dev Drive logic
    so it can be backported into the Windows Settings handler. It therefore:
      * has NO dependency on WinUI / Microsoft.UI.Xaml / CommunityToolkit,
      * uses ONLY public Windows APIs (winioctl FSCTL, fsutil.exe, Storage WMI v2),
      * isolates every platform call behind an interface (INativeVolumeApi,
        IProcessRunner, IStorageQuery) so the composing service is unit-testable
        against mocks.

    TFM matches the WinUI app (net10.0-windows10.0.26100.0) so the app can
    reference it without a target-framework mismatch. A Windows TFM is required
    because System.Management (WMI) is a Windows-only API.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DevDriveCore</RootNamespace>
    <AssemblyName>DevDriveCore</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Some public members are self-documenting; don't fail the build on missing XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Storage WMI v2 (root\Microsoft\Windows\Storage) access. Windows-only. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
